# Stable device names for the SO-101 devices (two serial adapters, plus the
# wrist camera when the cameras option is used), used by the so101 launcher
# as device_path values.
#
# The follower and leader ship identical USB serial bridges. If the two
# boards expose distinct serial numbers (check with
#   udevadm info -a -n /dev/ttyACM0 | grep '{serial}'
# ), prefer the serial matchers below and fill in the values. If they report
# the same or no serial, fall back to the physical hub port (ID_PATH): each
# arm keeps its name across reboots and replugs into the SAME port, and
# swapping ports swaps identities. Find the path values with
#   udevadm info -q property -n /dev/ttyACM0 | grep ID_PATH=
#
# Install: fill the values in, uncomment ONE matcher per device, then
#   sudo cp 60-so101.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Verify:
#   ls -l /dev/so101_*
#
# Keep the 60- prefix and the TAG+="uaccess" on every matcher: the tag must
# sort before systemd's 73-seat-late.rules to grant the seat user the ACL,
# and without it the nodes cannot open the device they just found.

# Preferred: unique board serials. These are the reference rig's; read your
# own with the udevadm command above and replace them.
SUBSYSTEM=="tty", ATTRS{serial}=="5B8E114745", SYMLINK+="so101_follower", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{serial}=="5B79016883", SYMLINK+="so101_leader", TAG+="uaccess"

# Fallback: physical hub port identity.
#SUBSYSTEM=="tty", ENV{ID_PATH}=="FILL_ME_FOLLOWER_PORT", SYMLINK+="so101_follower", TAG+="uaccess"
#SUBSYSTEM=="tty", ENV{ID_PATH}=="FILL_ME_LEADER_PORT", SYMLINK+="so101_leader", TAG+="uaccess"

# Wrist camera, required by the cameras launch option (its device_path is
# /dev/so101_wrist_cam): the Innomaker U20CAM-1080P on SO-ARM100's wrist
# camera mount, which offers the mode fragments/cameras.json5 asks for, MJPEG
# at 1280x720. The matcher below is its USB identity, read from a
# U20CAM-1080P-S1 unit:
#   udevadm info -a -n /dev/video0 | grep -E 'idVendor|idProduct|serial'
# Keep ATTR{index}=="0", which selects the capture node (index 1 is the UVC
# metadata node on the same device).
#
# Vendor and product identify a MODEL, not a unit, so a rig with two of these
# cameras has two devices matching this line, and udev leaves it undefined
# which keeps the symlink. Unlike the two adapters above, the camera gives no
# serial to tell units apart by: the unit read reports ATTRS{serial}=="SN0001",
# a placeholder rather than a number of its own.
# If that is your rig, comment this matcher out and uncomment the port-path
# one below, whose value you read with
#   udevadm info -q property -n /dev/video0 | grep ID_PATH=
# Port paths are specific to the machine and the socket, so they are not
# shipped filled in. Another camera model needs its own identity here, and
# must offer MJPEG at 1280x720; check before swapping models:
#   gst-device-monitor-1.0 Video/Source | grep -A2 'image/jpeg'
SUBSYSTEM=="video4linux", ATTR{index}=="0", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="6366", SYMLINK+="so101_wrist_cam", TAG+="uaccess"
#SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="FILL_ME_CAMERA_PORT", SYMLINK+="so101_wrist_cam", TAG+="uaccess"
