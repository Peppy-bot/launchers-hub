// The physical robots, each joined by name. A launch starts no robot and,
// with `--with robot_control`, the robots' MCP endpoint and the framework's,
// where a client halts the stack and adds no robot;
// `peppy stack join openarm:alpha --with v2` adds a robot,
// `peppy stack remove alpha` takes it away. An OpenArm stands the hardware
// version its join names, `v1` or `v2`; a join naming neither is refused.
//
//   peppy stack launch physical                                 # a new stack with no robot
//   peppy stack join openarm:alpha@jetson-1 --with v2           # a v2 with the browser panel
//   peppy stack join openarm:bravo@jetson-2 --with v1           # a v1 beside it
//   peppy stack join so101:charlie                              # an SO-101 under its leader arm
//   peppy stack remove alpha
//
//   peppy stack launch physical --with robot_control   # the robots' and the framework's MCP endpoints, waiting for robots
//   peppy stack join openarm:alpha@jetson-1 --with v2,cameras                 # driven over MCP, listed when the join returns
//   peppy stack launch physical --with xr_commander                           # the stack's headset, waiting for robots
//   peppy stack join openarm:alpha@jetson-1 --with v2,robot_commander=none    # led by the headset
//   peppy stack launch physical --join openarm:alpha@jetson-1 --join so101:bravo@jetson-2 --with alpha.v2
//
// A robot runs on the machine its name is placed on, `OPTION:NAME@CORE_NODE`,
// else on the coordinator; a word with a machine runs the part of the robot
// it selects there, such as `--with ai_brain_vla@cn-gpu-box` for the brain.
//
// Each robot fragment describes itself. The connections between a robot and
// the stack, the headset's slots and the MCP endpoint's slots, are the
// adjustments written here under the option that selects the robot.
{
  peppy_schema: "launcher/v1",

  components: [
    // The robots' MCP endpoint, selected with `--with robot_control`, and
    // the framework's endpoint beside it, whose fleet tools halt the stack.
    // Every robot is listed on the robots' endpoint with its moves.
    {
      name: "robot_control",
      cardinality: "zero_or_one",
      options: {
        robot_control: {
          fragments: ["mcp/fragments/framework_controls.json5", "mcp/fragments/robot_control.json5"],
        },
      },
    },
    // The stack's teleoperation headset, selected with `--with
    // xr_commander`: a robot running no commander of its own pairs into it,
    // and the headset drives the one chosen on its page.
    {
      name: "teleop",
      cardinality: "zero_or_one",
      options: {
        xr_commander: "teleop/fragments/xr_commander.json5",
      },
    },
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm: {
          fragments: ["openarm/fragments/openarm.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure,
            // how close its arms stand, where its cameras are mounted, where
            // its design lets it work, and the moves a model drives it by.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], collision: ["backbone_inst"],
                           camera_mounts: ["backbone_inst"], workspace: ["backbone_inst"],
                           postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The stack's headset leads a robot with no commander of its own:
            // the backbone pairs into it (the robot's fragment), and the
            // headset's buttons reach the robot's postures and recorder.
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none" },
              add_links: { postures: ["backbone_inst"] } },
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none", recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Real drivers report per-motor health and operator alerts; the
            // panel and the stack's headset show them.
            { target: "commander_inst", when: { robot_commander: "web_commander" },
              add_links: { motor_health: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"], alerts: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"] } },
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none" },
              add_links: { motor_health: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"], alerts: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"] } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity, by hardware version.
            { target: "recorder_inst", when: { hardware_version: "v1" },
              set_arguments: { robot_type: "openarm_v1", storage_root: "/tmp/lerobot_openarm_v1" } },
            { target: "recorder_inst", when: { hardware_version: "v2" },
              set_arguments: { robot_type: "openarm_v2", storage_root: "/tmp/lerobot_openarm_v2" } },
            // The brain's tools, listed beside the moves.
            { target: "robot_control_inst", when: { brain: ["ai_brain_vla", "vlm_router_brain"] },
              add_links: { item_perception: ["brain_inst"], item_manipulation: ["brain_inst"], brain_model: ["brain_inst"] } },
            // The robot's brain sees through the hardware rig's chest camera,
            // colour and depth from the ZED with the intrinsics it serves
            // (camera_geometry:v1). ai_brain_vla names what it finds by words
            // alone from the node's general vocabulary: no enrolment on the
            // robot, real objects are what SigLIP's words were trained on.
            // Its weights, about 7 GB, are downloaded at the first load on
            // the machine the brain is placed on, which needs a GPU.
            // vlm_router_brain asks a hosted model instead, with the key the
            // launching shell exports, and needs no GPU.
            // perception_model: the node's own default applies (see the node's peppy.json5, parameter perception_model).
            { target: "brain_inst", when: { brain: ["ai_brain_vla", "vlm_router_brain"], camera_rig: "cameras" },
              set_links: { camera: "chest", geometry: "chest" } },
            // The router brain's aligning model looks through the wrist
            // cameras of the rig; its wrist_cameras parameter names each
            // arm's camera by these instance ids.
            { target: "brain_inst", when: { brain: "vlm_router_brain", camera_rig: "cameras" },
              add_links: { wrist_cameras: ["wrist_left", "wrist_right"] } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // The stack's headset shows the rig in its panels while it leads
            // this robot.
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none", camera_rig: "cameras" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // Listed on the MCP endpoint; neither node describes a profile,
            // and the launcher lists no geometry on hardware.
            { target: "robot_control_inst", when: { camera_rig: "cameras" },
              add_links: { camera: ["wrist_left", "wrist_right"], depth_camera: ["chest"] } },
          ],
        },
        so101: {
          fragments: ["so101/fragments/so101.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure,
            // where its design lets it work, and the moves a model drives it by.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], workspace: ["backbone_inst"],
                           postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The stack's headset leads a robot with no commander of its own:
            // the backbone pairs into its right hand (the robot's fragment),
            // and the headset's buttons reach the robot's postures and
            // recorder.
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none" },
              add_links: { postures: ["backbone_inst"] } },
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none", recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // The follower reports per-motor health and operator alerts; the
            // stack's headset shows them.
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none" },
              add_links: { motor_health: ["follower_inst"], alerts: ["follower_inst"] } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity.
            { target: "recorder_inst",
              set_arguments: { robot_type: "so101", storage_root: "/tmp/lerobot_so101" } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras" },
              add_links: { color_cameras: ["wrist"] } },
            // The stack's headset shows the rig in its panel while it leads
            // this robot.
            { target: "headset_inst", when: { teleop: "xr_commander", robot_commander: "none", camera_rig: "cameras" },
              add_links: { color_cameras: ["wrist"] } },
            // Listed on the MCP endpoint; the uvc node describes no profile and
            // refuses every geometry call, so neither is listed on hardware.
            { target: "robot_control_inst", when: { camera_rig: "cameras" },
              add_links: { camera: ["wrist"] } },
          ],
        },
      },
    },
  ],

  deployments: [],

  adjustments: [
    // The framework's endpoint serves its fleet target alone: every physical
    // robot joins from the command line, on the machine its hardware is
    // wired to, so its stack target stays vacant.
    { target: "framework_controls_inst",
      set_daemon_scopes: { stack: { vacant: "physical robots join from the command line, on the machine their hardware is wired to" } } },
  ],
}
