{
  peppy_schema: "launcher/v1",
  description: [
    "The example robot of nodes-hub, in Rust: a brain that reads a camera and moves two arms through a backbone, a mock camera, and a node that records the camera into a video. It needs no hardware: the arms move in software only, and the mock camera replays a bundled video.",
    "`peppy stack launch rust_robot` starts it.",
    "The recorder writes the first 5 seconds of the camera to /tmp/video_reconstruction/reconstructed_video.mp4 on the machine it runs on.",
    "python_robot is the same stack in Python.",
  ],
  deployments: [
    {
      // A source references a node from your configured repositories by
      // `name:tag`. To use a node from a directory or git repository that is
      // not indexed yet, register it first: `peppy repo add <path-or-url>`
      // then `peppy repo refresh`.
      source: {
        name: "my_rust_robot_brain:v1",
      },
      instances: [
        {
          instance_id: "the_brain",
          links: {
            camera: "the_camera",
            robot_controller: "the_controller"
          }
        }
      ],
    },
    {
      source: {
        name: "my_rust_robot_backbone",
        tag: "v1"
      },
      instances: [
        {
          instance_id: "the_controller",
          links: {
            left_robot_arm: "the_left_arm",
            right_robot_arm: "the_right_arm"
          }
        }
      ]
    },
    {
      source: {
        name: "my_rust_robot_arm:v1",
      },
      instances: [
        {
          instance_id: "the_right_arm",
        },
        {
          instance_id: "the_left_arm",
        }
      ]
    },
    {
      source: {
        name: "uvc_camera_rust_mock:v1",
      },
      instances: [
        {
          instance_id: "the_camera",
          arguments: {
            device_path: "/dev/video0",
            video: {
              frame_rate: 30,
              resolution: {
                width: 1920,
                height: 1080,
              },
              camera_encoding: "mjpeg",
              topic_encoding: "rgb8",
            },
          }
        }
      ]
    },
    {
      source: {
        name: "uvc_camera_video_reconstruction_rust:v1"
      },
      instances: [
        {
          instance_id: "video_reconstruction_1",
          links: {
            camera: "the_camera"
          },
          arguments: {
            video_duration_seconds: 5
          },
        }
      ]
    },
  ]
}