// The Waldo simulation. It serves its HTTPS page on viewer_port (8080 by
// default) with a self-signed certificate: the engine's 3D viewer of the
// running world, streamed over WebTransport on UDP viewer_port, with the
// page's controls around it, the name tag over every robot with the button
// hiding them, and the hand teleop panel, all on from the first launch. Its scene_manipulation and
// object_state contracts take a scene commander. The world opens with no
// robot: every robot joins it through its initializer, bringing its own
// model, and any number stand in it at once, of any model in its
// catalogue, placed and moved through the scene contract. Each holds its
// own pairs on the simulation's four pairing slots, one per kind of pair:
// arms, grippers, rgb_cameras and rgbd_cameras. hand_teleop reads the
// plugins.hand_teleop block of each robot's model.
{
  peppy_schema: "launcher_fragment/v1",

  // The simulation supplies the `simulation` clock: naming simulation_inst
  // its publisher assigns that instance the domain, so it carries no
  // `framework.clock` of its own. Every instance of a simulated robot binds
  // to this domain, and Waldo's clock is the time they all read.
  framework: { clocks: { simulation: { publisher: "simulation_inst" } } },

  deployments: [
    {
      source: { name: "waldo", tag: "v1" },
      instances: [{
        instance_id: "simulation_inst",
        // Rendering is enabled by a robot's rendered camera rig. The debug
        // inspector and the plugins run whatever else the launch selects.
        // debug_inspector serves the engine's 3D viewer on the HTTPS page
        // (without it the page shows no viewer) and answers the
        // scene_manipulation and object_state calls of the scene commander.
        // plugins is the comma-separated list of plugins to run: every UI
        // element of the page is one, and within each place on the page
        // they show in this order. connection_status is the badge at the
        // top left with the session's state and the pose statistics.
        // frame_rate, robot_names and hand_teleop stack in the right
        // column: frame_rate is the viewer's frame rate and the menu of the
        // rates it may be capped at; robot_names has the viewer write
        // `<robot>@<core node>` over every robot, which tells the robots of
        // a crowded world apart, and is the button hiding and showing those
        // names; hand_teleop is the "Start camera" panel, which tracks the
        // operator's hands on the webcam and drives the arm of the chosen
        // robot ahead of that robot's pairing while a hand is tracked.
        // contact_markers and dark_mode are the toolbar's buttons at the
        // bottom (contact points shown or hidden, dark or light), and
        // viewer_hint is the line of the viewer's mouse, touch and keyboard
        // controls under them. Every plugin but hand_teleop needs
        // debug_inspector.
        // A robot's nodes start together with its join, and a robot holds
        // its pairs only once its backbone is up: the SO-101's Python
        // backbone takes several seconds to declare them, longer than the
        // engine's default lease, which would end the stay before the robot
        // is driven. The lease is also how long a robot whose nodes are gone
        // stays, and how long one paired as another model stays before its
        // stay ends naming both lists.
        arguments: { cameras_enabled: false, state_rate_hz: 100, debug_inspector: true, plugins: "connection_status,frame_rate,robot_names,hand_teleop,contact_markers,dark_mode,viewer_hint", world: "stage", robot_lease_ms: 10000 },
      }],
    },
  ],

  // Runtime scene and object control, selected with `--with
  // web_scene_commander` at launch.
  components: [
    {
      name: "scene_commander", cardinality: "zero_or_one",
      options: { web_scene_commander: "web_scene_commander.json5" },
    },
  ],

  adjustments: [
    // Waldo serves scene_lighting, scene_materials and sim_camera_control on
    // the same instance as its scene, so the scene commander's three
    // optional slots bind to it here; the adjustment is skipped when no
    // scene commander is selected.
    { target: "scene_commander_inst",
      set_links: { lighting: "simulation_inst", materials: "simulation_inst", cameras: "simulation_inst" } },
  ],
}
