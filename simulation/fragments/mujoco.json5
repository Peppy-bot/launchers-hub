// The MuJoCo simulation of an OpenArm. It loads the v2 model; a v1 robot
// the file deploys sets hardware_version at launch.
{
  peppy_schema: "launcher_fragment/v1",
  deployments: [
    {
      source: { name: "openarm_sim_mujoco", tag: "v1" },
      instances: [{
        instance_id: "simulation_inst",
        // Rendering is enabled by a robot's rendered camera rig.
        arguments: { cameras_enabled: false, hardware_version: "v2", state_rate_hz: 100 },
        links: {
          left_arm: { vacant: "a robot wired to this simulation's own limbs binds this" },
          right_arm: { vacant: "a robot wired to this simulation's own limbs binds this" },
          left_gripper: { vacant: "a robot wired to this simulation's own limbs binds this" },
          right_gripper: { vacant: "a robot wired to this simulation's own limbs binds this" },
          wrist_left: { vacant: "select cameras_sim to render this camera" },
          wrist_right: { vacant: "select cameras_sim to render this camera" },
          chest: { vacant: "select cameras_sim to render this camera" },
        },
        // In sim-time mode the simulation publishes MuJoCo's clock to each
        // participating daemon at state_rate_hz. In wall-time mode this
        // declaration resolves to an empty participant list.
        framework: { publishes_sim_time: true },
      }],
    },
  ],
}
