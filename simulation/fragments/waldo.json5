// The Waldo simulation. It serves its HTTPS page on viewer_port (8080 by
// default) with a self-signed certificate: the engine's 3D viewer of the
// running world, streamed over WebTransport on UDP viewer_port, and the hand
// teleop panel, both on from the first launch. Its scene_manipulation and
// object_state contracts take a scene commander. The world opens with no
// robot: every robot joins it through its initializer, bringing its own
// model, and any number stand in it at once, each holding its own pairs on
// the simulation's limb and camera slots. hand_teleop reads the
// plugins.hand_teleop block of each robot's model.
{
  peppy_schema: "launcher_fragment/v1",

  // The simulation supplies the `simulation` clock: naming simulation_inst
  // its publisher assigns that instance the domain, so it carries no
  // `framework.clock` of its own. Every instance of a simulated robot binds
  // to this domain, and Waldo's clock is the time they all read.
  framework: { clocks: { simulation: { publisher: "simulation_inst" } } },

  deployments: [
    {
      source: { name: "waldo", tag: "v1" },
      instances: [{
        instance_id: "simulation_inst",
        // Rendering is enabled by a robot's rendered camera rig. plugins is
        // the comma-separated list of engine plugins to run, and both run
        // whatever else the launch selects. sim_inspector serves the
        // engine's 3D viewer on the HTTPS page (without it the page is
        // blank) and answers the scene_manipulation and object_state calls of
        // the scene commander; hand_teleop is the page's "Start camera"
        // panel, which tracks the operator's hands on the webcam and drives
        // the arm of the chosen robot ahead of that robot's pairing while a
        // hand is tracked.
        arguments: { cameras_enabled: false, state_rate_hz: 100, plugins: "hand_teleop,sim_inspector", world: "stage" },
      }],
    },
  ],

  // Runtime scene and object control, selected with `--with
  // web_scene_commander` at launch.
  components: [
    {
      name: "scene_commander", cardinality: "zero_or_one",
      options: { web_scene_commander: "web_scene_commander.json5" },
    },
  ],

  adjustments: [
    // Waldo serves scene_lighting, scene_materials and sim_camera_control on
    // the same instance as its scene, so the scene commander's three
    // optional slots bind to it here; the adjustment is skipped when no
    // scene commander is selected.
    { target: "scene_commander_inst",
      set_links: { lighting: "simulation_inst", materials: "simulation_inst", cameras: "simulation_inst" } },
  ],
}
