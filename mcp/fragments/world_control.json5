// The simulated world over MCP, with the applier of worlds behind its world
// target. The server built into peppy serves the simulation:v1 exposure
// from the MCP hub as one endpoint, http://127.0.0.1:8902/simulation/v1/mcp.
// The exposure covers the scene, the controls of its objects, its light
// sources, its daylight and its weather, and its materials. It also covers a
// picture of the scene from any viewpoint, the simulation clock, where a
// robot can work in the scene, the rate at which the simulation renders the
// cameras of each robot's rig and the holds that keep a camera at its own
// rate, and its worlds: the live world as a world document, the check and
// the apply of one, a workflow run in one and the judges that check it. The
// server is a process of its own beside the stack's robot_control endpoint
// on port 8900 and the framework_controls endpoint on port 8903, which
// simulation_mcp's robot_control option deploys together. Its instance id
// is its own, so the browser scene panel (web_scene_commander) runs beside
// it; it reads the simulation's clock, as that panel does. The exposure
// binds object_controls, scene_lighting, scene_daylight, scene_materials,
// scene_view, simulation_clock, scene_workspace and sim_sensor_streams,
// which Waldo alone implements, so the simulation_mcp launcher, whose
// world_control axis deploys it, requires Waldo beside it; `--with
// world_control=none` switches it off.
//
// The applier of worlds, sim_harness_inst, serves the world target. It
// drives Waldo through its links (the workspace link measures the surfaces
// it teaches each robot), the workflow director through `director`,
// each simulated robot through the set slots that the launcher fills for
// each robot option, and the stack and the fleet through the daemon. It
// declares no core_node, so it runs on the coordinator, as an instance
// serving a daemon target must; the launcher gives its stack target the
// scope of the framework's endpoint. It reads the simulation's clock, which
// every instance it binds reads; its own waits count wall time: it waits
// on the daemon, Waldo and the director.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { exposures: ["simulation:v1"] },
      instances: [
        {
          instance_id: "world_control_inst",
          // The derived node's only parameter: the port the server
          // prefers on 127.0.0.1, serving the exposure at
          // /simulation/v1/mcp. A server that finds the port held takes
          // another and announces it.
          arguments: { port: 8902 },
          // One entry per target of the exposure: nine the simulation's,
          // and the world target the applier's.
          links: {
            scene: "simulation_inst",
            controls: "simulation_inst",
            lighting: "simulation_inst",
            daylight: "simulation_inst",
            materials: "simulation_inst",
            view: "simulation_inst",
            clock: "simulation_inst",
            workspace: "simulation_inst",
            sensor_streams: "simulation_inst",
            world: "sim_harness_inst",
          },
          framework: { clock: "simulation" },
        },
      ],
    },
    {
      source: { name: "sim_harness", tag: "v1" },
      instances: [
        {
          instance_id: "sim_harness_inst",
          links: {
            world: "simulation_inst",
            scene: "simulation_inst",
            workspace: "simulation_inst",
            sim_clock: "simulation_inst",
            sensor_streams: "simulation_inst",
            director: "workflow_director_inst",
          },
          // The fleet listing and its changes, the leases it takes and
          // lends to the director, and the move check before each move.
          daemon_scopes: { fleet: { members: ["list", "changes", "lease", "check_move"] } },
          framework: { clock: "simulation" },
        },
      ],
    },
  ],
}
