// The peppy framework's MCP endpoint, at
// http://127.0.0.1:8903/framework_controls/v1/mcp: a client adds robots to
// the stack and removes them, reads the fleet of the stack, and halts the
// stack. The server built into peppy serves the framework_controls:v1
// exposure from the MCP hub. Its two targets, stack and fleet, are daemon
// targets: the peppy daemon that started the server serves them and no node
// implements them, so the instance takes no links.
//
// This file gives the fleet target its scope: list and halt, so a client of
// every launcher that deploys the endpoint can read the fleet and halt the
// stack. The scope does not give clear_halt, so the endpoint serves no
// fleet.clear_halt, and an MCP client clears no halt: the operator clears it
// with `peppy fleet clear-halt`. The launcher that includes this fragment
// gives the stack target its scope with a `set_daemon_scopes` adjustment on
// framework_controls_inst: the robot options of that launcher, a description
// for each, the features of each option (the name a client adds it by, the
// own axis and option it selects, and a description), and max_copies; or the
// vacant scope, with the reason, when the launcher offers MCP clients no
// robot to add. A launch without that scope is refused. The robots it adds
// are listed on the robots' endpoint, so the option that includes this
// fragment also deploys that endpoint.
//
// Every launcher with robots deploys it beside the robots' endpoint on port
// 8900, on its robot_control option: simulation_mcp deploys that option and
// gives the stack target its two robot options, and physical,
// openarm_simulation and so101_simulation serve it with `--with
// robot_control` and leave the stack target vacant. The instance declares
// no core_node, so it runs on the coordinator, the daemon that adds and
// removes the copies and holds the halt, as an instance serving a daemon
// target must. It reads wall time: it waits on the daemon, not on the
// simulation.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { exposures: ["framework_controls:v1"] },
      instances: [
        {
          instance_id: "framework_controls_inst",
          // The derived node's only parameter: the port the server prefers
          // on 127.0.0.1, serving the exposure at
          // /framework_controls/v1/mcp, beside the robots' endpoint on 8900
          // and the simulated world's on 8902. A server that finds the port
          // held takes another and announces it.
          arguments: { port: 8903 },
          // The fleet listing and the halt: the members of fleet:v1 that
          // the exposure selects as fleet.list and fleet.halt.
          daemon_scopes: { fleet: { members: ["list", "halt"] } },
        },
      ],
    },
  ],
}
