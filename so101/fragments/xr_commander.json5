// The WebXR command headset: pose-led teleop from one controller hand. The
// backbone solves streamed poses through the SO-101 URDF, so this fragment
// flips it into pose mode; the left-hand slots stay vacant on a single-arm
// rig.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: {
        name: "xr_commander",
        tag: "v1",
      },
      instances: [
        {
          // Self-generated TLS certificate, https on its default port 4443;
          // open the URL from the startup log and click through the warning
          // once.
          instance_id: "commander_inst",
          arguments: {
            command_rate_hz: 60,
            // The SO-101 jaw needs no more than half its travel; a full
            // trigger release opens to this.
            gripper_open_fraction: 0.5,
          },
          links: {
            // The right hand drives the arm's pose slot and the gripper; the
            // left-hand slots stay vacant on this single-arm robot.
            right_arm: "backbone_inst/leader_pose",
            right_gripper: "backbone_inst/leader_gripper",
            left_arm: { vacant: "single-arm robot: only the right hand drives" },
            left_gripper: { vacant: "single-arm robot: only the right hand drives" },
            // The whole-robot posture moves (A = home, B = ready).
            postures: ["backbone_inst"],
            // Per-motor health and operator alerts from the one follower.
            motor_health: ["follower_inst"],
            alerts: ["follower_inst"],
          },
        },
      ],
    },
  ],

  adjustments: [
    // Pose-led teleop: the backbone solves streamed end-effector poses
    // instead of following joint targets. The joint-mode vacancy annotation
    // does not apply under pose mode, so it is unset; the joint leader slot
    // goes vacant instead (nothing pairs into it from a headset).
    { target: "backbone_inst",
      set_arguments: { upstream_mode: "pose" },
      set_links: {
        leader_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slot" },
      },
      unset_links: ["leader_pose"] },
  ],
}
