// The engine-agnostic half of a simulated robot: four relays pairing the
// simulator's limbs onto the same instance ids the real CAN drivers use, so
// every downstream link (initializer, backbone, commander, recorder) is
// identical under real and sim. Shared by the mujoco and isaac_sim options,
// which pair it with the engine fragment that differs.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "openarm_arm_sim", tag: "v1" },
      instances: [
        { instance_id: "left_arm",  links: { engine: "sim_inst/left_arm" } },
        { instance_id: "right_arm", links: { engine: "sim_inst/right_arm" } },
      ],
    },
    {
      source: { name: "openarm_gripper_sim", tag: "v1" },
      instances: [
        { instance_id: "left_gripper",  links: { engine: "sim_inst/left_gripper" } },
        { instance_id: "right_gripper", links: { engine: "sim_inst/right_gripper" } },
      ],
    },
  ],

  adjustments: [
    // Sim runs faster than the real arm: raise the governed EE-speed cap.
    { target: "backbone_inst",
      set_arguments: { max_ee_velocity_m_s: 0.5 } },
    // The panel streams the live cap the backbone follows; the headset has
    // no such argument, so this one is guarded on the panel's shape.
    { target: "commander_inst", when: { commander: "web_commander" },
      set_arguments: { max_ee_velocity_m_s: 0.5 } },
  ],
}
