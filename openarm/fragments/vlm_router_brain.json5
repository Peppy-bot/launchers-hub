// The AI brain whose models are hosted vision-language models, reached over
// the network: the node that serves item_perception, item_manipulation and
// brain_model, the environment aware layer above limb_motion. It needs no
// GPU. It reaches its models one of two ways, from its environment:
//   - through an OpenAI-compatible API, a local model server among them:
//     OPENAI_COMPATIBLE_API_BASE, the base address of the API, and
//     OPENAI_COMPATIBLE_API_KEY, the key for it. The brain then calls every
//     model through the API, asks for each by its catalog name, and reads
//     no provider key;
//   - at the provider of each model that the launcher sets: GEMINI_API_KEY
//     for a model on Google's API, OPENROUTER_API_KEY for a model on
//     OpenRouter.
// A launcher names these variables with `set_env_from_launch` on
// brain_inst, as a list, or as a `one_of` of both ways, whose first set
// that the shell holds complete the brain takes: the daemon then takes the
// variables from the shell that launches, keeps them, and gives them to the
// brain that the launch or a later join starts, and it refuses a launch
// that can start the brain without them. A launcher that names no variable
// passes the brain the environment of the shell whose launch or join starts
// it (a local launch passes that shell's environment to the nodes it starts
// on the machine). switch_model changes a model to another of its catalog,
// and with provider keys the switch fails when the brain does not have the
// key of that model.
// It leads no pairing and reaches the arms only through the backbone's
// discrete moves, so it composes with the selected commander: the operator
// and the brain send the same kind of goal to the same producer, and the
// governor sizes both on the way down. The brain's
// tools are listed on the stack's endpoint as this robot's, so a model
// drives it by the robot's name beside the direct moves.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "vlm_router_brain", tag: "v1" },
      instances: [
        {
          instance_id: "brain_inst",
          arguments: {
            // Each arm with the gripper it carries, in the order get_state
            // reports the grippers, under the names limb_motion addresses
            // them by.
            limbs: "left_arm:left_gripper,right_arm:right_gripper",
            // The camera the brain looks through: the chest camera, fixed
            // to the torso, as the initializer's sensor_mounts names it.
            camera_name: "chest",
            // Two limb_states periods: the worst wait measured in Waldo, plus one dropped sample.
            lookup_timeout_s: 0.1,
            // perception_model: the node's own default applies (see the node's
            // peppy.json5, parameter perception_model) where the launcher does
            // not set it with an adjustment.
            // manipulation_model: each launcher that carries this brain sets it
            // to a catalog model with an adjustment, so both brains stand here
            // with the same arguments.
          },
          links: {
            // The governed producer of limb_motion. Required: a launch with
            // no producer bound is refused.
            limb_motion: "backbone_inst",
            // The robot's measured limbs, from the same backbone: a grab
            // reads the gripper's opening after the lift from it. Required
            // like limb_motion.
            limb_state: "backbone_inst",
            // The camera the brain looks through, optional on the node: the
            // rig that renders it binds the chest camera here
            // (cameras_sim.json5); without a rig the brain refuses both
            // searches with "no perception source" and serves the rest.
            camera: { vacant: "select a camera rig, cameras or cameras_sim, to give the brain the chest camera" },
            // Where that camera's pixels point, from the same camera: the
            // rig binds it beside `camera`. Vacant, no pixel can become a
            // position and both searches are refused naming the slot.
            geometry: { vacant: "select a camera rig, cameras or cameras_sim, to give the brain the chest camera's geometry" },
            // The robot frame and the camera's frame, from the robot's model.
            sensor_mounts: "init_inst",
            // Where the camera stands at the time of each picture.
            transform_lookup: "transforms_inst",
            // The robot's motion planner, optional on the node: a launcher
            // binds the copy's planner here when the copy selects one;
            // without it the brain moves by the backbone's lines alone.
            motion_planning: { vacant: "select motion_planner=motion_planner to plan the brain's transits around what the chest camera sees" },
          },
        },
      ],
    },
  ],
}
