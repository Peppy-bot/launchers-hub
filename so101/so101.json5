// SO-101 single-arm stack, composed: the command surface, the recorder,
// and a camera selected at launch time. The commander has no default; every
// option implies hardware or intent (leader arm = immediate teleop chase,
// XR = headset, panel = browser), so each launch names its choice:
//
//   peppy stack launch so101 --with=so101_leader
//   peppy stack launch so101 --with=so101_commander
//   peppy stack launch so101 --with=xr_commander,lerobot_recorder,cameras
//
// Before first launch: install rules/60-so101.rules (stable serial symlinks)
// and calibrate both arms with lerobot-calibrate; the host paths below are
// where this launcher expects them. See README.md.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "commander",
      provides: ["commander_inst"],
      options: {
        so101_leader: "fragments/so101_leader.json5",
        xr_commander: "fragments/xr_commander.json5",
        so101_commander: "fragments/so101_commander.json5",
      },
    },
    {
      name: "recorder",
      optional: true,
      provides: ["recorder_inst"],
      options: { lerobot_recorder: "fragments/lerobot_recorder.json5" },
    },
    {
      name: "cameras",
      optional: true,
      provides: ["front"],
      options: { cameras: "fragments/cameras.json5" },
    },
  ],

  constraints: [
    // Episodes start via the recorder's record_episode action, and only the
    // XR commander carries that button; a recorder deployed beside the
    // leader arm would idle with no way to trigger it.
    { when: { recorder: "lerobot_recorder" },
      requires: [{ commander: "xr_commander" }],
      reason: "only the XR commander can start an episode: the leader arm has no recorder slot" },
    // A camera needs a consumer: only the recorder and the XR commander
    // have camera slots, so without either the camera opens its device and
    // publishes to zero subscribers.
    { when: { cameras: "cameras" },
      requires: [{ recorder: "lerobot_recorder" }, { commander: "xr_commander" }],
      reason: "nothing in this selection consumes a camera stream: only the recorder and the XR commander have camera slots" },
  ],

  deployments: [
    {
      source: { name: "so101_follower", tag: "v1" },
      instances: [
        {
          instance_id: "follower_inst",
          arguments: {
            device_path: "/dev/so101_follower",
            calibration_dir: "/var/lib/so101/calibration",
            robot_id: "follower",
            // lerobot's validated teleop rate for this bus. The node-default
            // per-cycle clamp (10 deg) leaves a 5x margin over the
            // backbone's chase step (2 rad/s at 60 Hz is 1.91 deg/cycle);
            // retune both together or the clamp starts shaving the chase.
            control_rate_hz: 60,
            state_rate_hz: 60,
          },
        },
      ],
    },
    {
      source: { name: "so101_backbone", tag: "v1" },
      instances: [
        {
          instance_id: "backbone_inst",
          arguments: {
            // Joint-led by default: the leader_arm pairing is the followed
            // upstream command (the headset fragment flips this to "pose").
            upstream_mode: "joints",
            control_rate_hz: 60,
            // The stream's one limiter: max end-effector speed. Generous
            // for teleop feel; lower for cautious sessions. The linear cap
            // is the primary knob.
            max_ee_velocity_m_s: 2.0,
            max_ee_angular_velocity_rad_s: 12.0,
            max_gripper_rate_frac_s: 10.0,
          },
          links: {
            // The exclusive command loops with the follower: governed-shape
            // setpoints stream down, measured state streams back.
            arm_link: "follower_inst",
            gripper_link: "follower_inst",
            // The pose slot stays vacant under joint-led teleop (the headset
            // fragment unsets this and pairs into it instead).
            leader_pose: { vacant: "upstream_mode joints: arm commands arrive on the joint slot" },
          },
        },
      ],
    },
  ],
}
