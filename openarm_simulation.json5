// An OpenArm in a simulation: the simulation is the stack, Waldo unless a
// launch word selects another, and the robot is a copy, alpha, a v2 with
// the browser panel, its ids minted under its name: alpha_backbone_inst,
// alpha_commander_inst. `stack remove` takes a copy off and `stack join`
// adds one, the simulation running throughout, and `--join OPTION:NAME`
// names another copy at launch.
//
//   peppy stack launch openarm_simulation   # Waldo and alpha
//   peppy stack launch openarm_simulation --with mujoco,alpha.recorder=lerobot_recorder,alpha.camera_rig=cameras_sim
//   peppy stack launch openarm_simulation --with robot_control,alpha.cameras_sim   # alpha driven over MCP too, its cameras served
//   peppy stack launch openarm_simulation --with xr_commander,alpha.robot_commander=none   # alpha led by the stack's headset
//   peppy stack join so101_sim:charlo       # an SO-101 beside alpha
//   peppy stack remove alpha                # the simulation keeps running
//
// The robot axis offers every simulated robot, so an SO-101 joins beside
// the OpenArm; every simulation stands as many robots as the machines can
// run, of any model, each joined copy bringing its own. A copy named with
// `--join` is composed as a join, as `stack join` is, and a join cannot
// turn rendering on: the simulation renders when the copy listed here
// selects its rig, as the second and third commands above do, so an SO-101
// joined to a launch without one has no `wrist` camera, and `--with
// cameras_sim` on its join is refused. `--with robot_control` serves the
// robots' MCP endpoint, http://127.0.0.1:8900/robot_control/v1/mcp, where
// every robot is listed with its moves. `--with xr_commander` runs the
// stack's headset, which leads every robot that runs no commander of its
// own, one at a time, chosen on the headset's page.
// mcp/simulation_mcp.json5 is this file with the endpoint and the headset
// deployed, no robot listed, every robot led by the headset by default, and
// rendering on from the launch.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "simulation/fragments/mujoco.json5",
        isaac_sim: "simulation/fragments/isaac_sim.json5",
        waldo: "simulation/fragments/waldo.json5",
      },
    },
    // The robots' MCP endpoint, selected with `--with robot_control`. Every
    // robot is listed on it with its moves.
    {
      name: "robot_control",
      cardinality: "zero_or_one",
      options: {
        robot_control: "mcp/fragments/robot_control.json5",
      },
    },
    // The stack's teleoperation headset, selected with `--with
    // xr_commander`: a robot running no commander of its own pairs into it,
    // and the headset drives the one chosen on its page.
    {
      name: "headset",
      cardinality: "zero_or_one",
      options: {
        xr_commander: "headset/fragments/xr_commander.json5",
      },
    },
    // Every simulated robot, an option of the same name in every simulation
    // launcher. Every simulation stands any number of them, of any model.
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm_sim: {
          fragments: ["openarm/fragments/openarm_sim.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure,
            // how close its arms stand, where its cameras are mounted, where
            // its design lets it work, and the moves a model drives it by.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], collision: ["backbone_inst"],
                           camera_mounts: ["backbone_inst"], workspace: ["backbone_inst"],
                           postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The stack's headset leads a robot with no commander of its own:
            // the backbone pairs into it (the robot's fragment), and the
            // headset's buttons reach the robot's postures and recorder.
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none" },
              add_links: { postures: ["backbone_inst"] } },
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none", recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // The panel streams the live cap the simulated backbone starts on.
            { target: "commander_inst", when: { robot_commander: "web_commander" },
              set_arguments: { max_ee_velocity_m_s: 0.5 } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity, by hardware version and engine.
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "mujoco" },
              set_arguments: { robot_type: "openarm_v1_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "isaac_sim" },
              set_arguments: { robot_type: "openarm_v1_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "waldo" },
              set_arguments: { robot_type: "openarm_v1_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "mujoco" },
              set_arguments: { robot_type: "openarm_v2_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "isaac_sim" },
              set_arguments: { robot_type: "openarm_v2_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "waldo" },
              set_arguments: { robot_type: "openarm_v2_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
            // The brain's tools, listed beside the moves.
            { target: "robot_control_inst", when: { brain: "ai_brain_vla" },
              add_links: { item_perception: ["brain_inst"], item_manipulation: ["brain_inst"] } },
            // The simulated robot's brain sees: it finds and names items with
            // the SAM 3 and SigLIP pipeline, by words from the node's general
            // vocabulary, looking through the chest camera the rendered rig
            // binds, color and depth from one producer. The pipeline runs in
            // the brain's node, on the machine the brain runs on: the
            // robot's, or the one its word names (`ai_brain_vla@cn-gpu-box`).
            // It computes on that machine's NVIDIA GPU, or slowly on its CPU
            // when the machine has none, and its first load on a machine
            // downloads its weights there. A brain on another machine than
            // the simulation's reads the chest camera over the network. Under
            // Waldo it also enrols the catalogue's table objects, the
            // prototypes the node ships, so a rendered mesh whose look the
            // words miss is still reported under the catalogue's name; this
            // is a condition of the simulation, not of the robot, whose brain
            // names by words alone.
            { target: "brain_inst", when: { brain: "ai_brain_vla" },
              set_arguments: { perception_backend: "sam3_siglip" } },
            { target: "brain_inst", when: { brain: "ai_brain_vla", simulation: "waldo" },
              set_arguments: { perception_gallery: "waldo_catalogue" } },
            { target: "brain_inst", when: { brain: "ai_brain_vla", camera_rig: "cameras_sim" },
              set_links: { camera: "chest", geometry: "chest" } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // The stack's headset shows the rig in its panels while it leads
            // this robot.
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none", camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // Listed on the MCP endpoint with profile and geometry.
            { target: "robot_control_inst", when: { camera_rig: "cameras_sim" },
              add_links: { camera: ["wrist_left", "wrist_right"], depth_camera: ["chest"],
                           camera_profile: ["wrist_left", "wrist_right", "chest"],
                           camera_geometry: ["wrist_left", "wrist_right", "chest"] } },
            // The commander, recorder and brain are shared with the physical robot.
            { target: "commander_inst", set_framework: { clock: "simulation" } },
            { target: "recorder_inst", set_framework: { clock: "simulation" } },
            { target: "brain_inst", set_framework: { clock: "simulation" } },
            // Rendering, while this robot films.
            { target: "simulation_inst", when: { camera_rig: "cameras_sim" },
              set_arguments: { cameras_enabled: true } },
          ],
        },
        so101_sim: {
          fragments: ["so101/fragments/so101_sim.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure,
            // where its design lets it work, and the moves a model drives it by.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], workspace: ["backbone_inst"],
                           postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The stack's headset leads a robot with no commander of its own:
            // the backbone pairs into its right hand (the robot's fragment),
            // and the headset's buttons reach the robot's postures and
            // recorder.
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none" },
              add_links: { postures: ["backbone_inst"] } },
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none", recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity, by engine.
            { target: "recorder_inst", when: { simulation: "mujoco" },
              set_arguments: { robot_type: "so101_mujoco", storage_root: "/tmp/lerobot_so101_mujoco" } },
            { target: "recorder_inst", when: { simulation: "isaac_sim" },
              set_arguments: { robot_type: "so101_isaac", storage_root: "/tmp/lerobot_so101_isaac" } },
            { target: "recorder_inst", when: { simulation: "waldo" },
              set_arguments: { robot_type: "so101_waldo", storage_root: "/tmp/lerobot_so101_waldo" } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist"] } },
            // The stack's headset shows the rig in its panel while it leads
            // this robot.
            { target: "headset_inst", when: { headset: "xr_commander", robot_commander: "none", camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist"] } },
            // Listed on the MCP endpoint with profile and geometry.
            { target: "robot_control_inst", when: { camera_rig: "cameras_sim" },
              add_links: { camera: ["wrist"], camera_profile: ["wrist"], camera_geometry: ["wrist"] } },
            // The commander and recorder are shared with the physical robot.
            { target: "commander_inst", set_framework: { clock: "simulation" } },
            { target: "recorder_inst", set_framework: { clock: "simulation" } },
            // Rendering, while this robot films.
            { target: "simulation_inst", when: { camera_rig: "cameras_sim" },
              set_arguments: { cameras_enabled: true } },
          ],
        },
      },
    },
  ],

  // Component deployments: the entry names the component and its option,
  // and the robot entry lists the copy the launch starts, set up as its
  // fragment deploys it; `--join OPTION:NAME` names another.
  deployments: [
    { simulation: "waldo" },
    { robot: "openarm_sim", instances: [{ instance_id: "alpha" }] },
  ],

  adjustments: [
    // The server reads the simulation's clock, as every instance a robot
    // copy runs does; each simulated robot's fragment binds its own.
    { target: "robot_control_inst", set_framework: { clock: "simulation" } },
    // The stack's headset reads the simulation's clock like every instance
    // a robot copy runs, and Waldo's headset panel shows it: the link that
    // opens its page in the headset.
    { target: "headset_inst", set_framework: { clock: "simulation" } },
    { target: "simulation_inst", when: { simulation: "waldo", headset: "xr_commander" },
      add_links: { headsets: ["headset_inst"] } },
  ],
}
