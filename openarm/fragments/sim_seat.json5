// How a simulated robot reaches a simulation that seats robots: the robot's
// initializer takes its seat there, standing it with its own model, and the
// four relays pair into the seat's limbs instead of the simulation's own.
// The simulation tells its robots apart by the seat that commands them, so a
// stack holds as many as its machines can run.
{
  peppy_schema: "launcher_fragment/v1",

  adjustments: [
    // The seat, and the limbs it offers the relays in place of the
    // vacancies a robot without one leaves.
    { target: "init_inst", set_links: { simulation: "simulation_inst" },
      unset_links: ["left_arm_link", "right_arm_link", "left_gripper_link", "right_gripper_link"] },
    { target: "left_arm_inst",      set_links: { simulation: "init_inst/left_arm_link" } },
    { target: "right_arm_inst",     set_links: { simulation: "init_inst/right_arm_link" } },
    { target: "left_gripper_inst",  set_links: { simulation: "init_inst/left_gripper_link" } },
    { target: "right_gripper_inst", set_links: { simulation: "init_inst/right_gripper_link" } },
  ],
}
