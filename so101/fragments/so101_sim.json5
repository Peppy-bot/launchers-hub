// A simulated SO-101: the shared SO-101 control, with the simulation
// standing its limbs. The launcher's simulation axis supplies
// simulation_inst; this robot's initializer joins it, naming the copy the
// robot runs as and the so101 model to stand, and the backbone leads the
// simulation's limb slots, arms and grippers, on the same pairings it leads
// the real follower. There is no follower node: the engine plays the
// follower role toward the backbone. Waldo and Isaac Sim stand any number
// of robots at once, of any model; MuJoCo stands one at a time, this
// robot's file being its whole world.
//
// It comes up with no commander, so it runs on a machine with no SO-101
// hardware: a CI runner, a development host, a plain
// `peppy stack join so101_sim -i charlo`. A copy's `with` or a join word
// selects a command surface.
{
  peppy_schema: "launcher_fragment/v1",

  // The option this robot deploys on its own axes unless a copy's `with`
  // says otherwise.
  deployments: [
    { control: "control_common" },
    // No teleop surface unless a copy's `with` selects one: actions drive
    // the robot, and nothing here opens a device.
    { robot_commander: "no_commander" },
  ],

  // The robot's own axes, `one` or `zero_or_one`, filled per copy of this
  // fragment: `with: { robot_commander: "xr_commander" }` on a copy in the
  // launcher, `--with xr_commander` on `stack join`.
  components: [
    // The initializer and backbone every SO-101 shares.
    {
      name: "control", provides: ["init_inst", "backbone_inst"],
      options: { control_common: "control_common.json5" },
    },
    // No `provides`: the action-only option deploys nothing, and a provided
    // id must be defined by every option.
    {
      name: "robot_commander",
      options: {
        no_commander: "no_commander.json5",
        // A real leader arm driving the simulated follower: LeRobot data
        // without the follower. It opens /dev/so101_leader.
        so101_leader: "so101_leader.json5",
        xr_commander: "../../robot_commanders/fragments/xr_commander.json5",
        // The robot's front camera over MCP. It streams nothing into the
        // backbone, exactly as no_commander, so the option is that
        // fragment's vacancies with the server as its second part: the list
        // form merges the two, and the vacancies are written once.
        mcp_commander: ["no_commander.json5", "mcp_commander.json5"],
      },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "../../recording/fragments/lerobot_recorder.json5" },
    },
    // The episode viewpoint, rendered by the simulation in place of the
    // webcam. A rendered camera costs the simulation a frame budget, so the
    // rig runs only when selected.
    {
      name: "camera_rig", cardinality: "zero_or_one", provides: ["front"],
      options: { cameras_sim: "cameras_sim.json5" },
    },
  ],

  constraints: [
    // The camera stream needs a consumer: the recorder films it, the XR
    // headset shows it in its panel, and the MCP commander publishes it as
    // a resource and tools, the model its consumer. The rig must feed at
    // least one of them. The browser scene commander lists it in its camera
    // panel too, but its axis belongs to the simulation's fragment, not to
    // this robot's or the launcher's, so a constraint here cannot name it.
    { when: { camera_rig: "cameras_sim" },
      requires: [
        { recorder: "lerobot_recorder" },
        { robot_commander: ["xr_commander", "mcp_commander"] },
      ],
      reason: "camera streams need a consumer; select lerobot_recorder, xr_commander or mcp_commander" },
    // The MCP commander's exposure list is fixed and its one target takes a
    // link, so the camera target cannot be optional: the rendered rig must
    // run beside it.
    { when: { robot_commander: "mcp_commander" },
      requires: [{ camera_rig: "cameras_sim" }],
      reason: "mcp_commander serves the robot's front camera and its exposure list is fixed, so the camera target cannot be optional; select cameras_sim" },
  ],

  adjustments: [
    // Everything this robot runs reads the simulation's clock. The control,
    // commander and recorder fragments are shared with the physical robot,
    // so this robot binds the instances they deploy; the camera rig is the
    // simulation's own and declares the clock on its instance.
    { target: "init_inst", set_framework: { clock: "simulation" } },
    { target: "backbone_inst", set_framework: { clock: "simulation" } },
    { target: "commander_inst", set_framework: { clock: "simulation" } },
    { target: "recorder_inst", set_framework: { clock: "simulation" } },
    // Where this robot's limbs are: the simulation's. The initializer joins
    // it as this robot, and the simulation answers for every limb it
    // stands, so no driver fills the initializer's limbs slot.
    { target: "init_inst",
      set_links: { simulation: "simulation_inst" } },
    // The backbone leads the simulation's limb slots, one per kind of limb:
    // governed commands flow down each pair and this robot's measured state
    // returns on it. The simulation tells a pair's robot by its copy and
    // its limb by the backbone link it comes from.
    { target: "backbone_inst",
      set_links: {
        arm: "simulation_inst/arms",
        gripper: "simulation_inst/grippers",
      } },
    // Dataset identity follows the simulation. /tmp lasts until reboot;
    // select durable storage for saved datasets.
    { target: "recorder_inst", when: { simulation: "mujoco" },
      set_arguments: { robot_type: "so101_mujoco", storage_root: "/tmp/lerobot_so101_mujoco" } },
    { target: "recorder_inst", when: { simulation: "isaac_sim" },
      set_arguments: { robot_type: "so101_isaac", storage_root: "/tmp/lerobot_so101_isaac" } },
    { target: "recorder_inst", when: { simulation: "waldo" },
      set_arguments: { robot_type: "so101_waldo", storage_root: "/tmp/lerobot_so101_waldo" } },
  ],
}
