// An SO-101 in a simulation: openarm_simulation with another robot in it.
// The simulation is the stack, Waldo unless a launch word selects another,
// and a robot is a copy named at launch, `--join so101_sim:alpha`, a
// simulated SO-101 with no commander, its ids minted under its name:
// alpha_init_inst, alpha_backbone_inst. It opens no device, so it launches
// on a machine with no SO-101 hardware, and actions drive its arm. The file
// lists no copy, so a bare launch is the simulation alone; `stack remove`
// takes a copy off and `stack join` adds one, the simulation running
// throughout.
//
//   peppy stack launch so101_simulation --join so101_sim:alpha                  # Waldo and one SO-101
//   peppy stack launch so101_simulation --join so101_sim:alpha --with mujoco    # the same robot, alone in MuJoCo
//   peppy stack launch so101_simulation --join so101_sim:alpha --with isaac_sim
//   peppy stack launch so101_simulation --join so101_sim:alpha --with alpha.so101_leader   # a real leader arm driving the simulated follower
//   peppy stack launch so101_simulation --join so101_sim:alpha --with alpha.xr_commander,alpha.lerobot_recorder,alpha.cameras_sim
//   peppy stack launch so101_simulation --join so101_sim:alpha --with robot_control_sim,alpha.mcp_commander,alpha.cameras_sim   # driven over MCP, its front camera served
//   peppy stack remove alpha                             # the simulation keeps running
//
// The robot axis offers every simulated robot, so an OpenArm joins beside
// the SO-101. Waldo and Isaac Sim stand as many robots as the machines can
// run, of any model, each joined copy bringing its own:
//
//   peppy stack join so101_sim -i charlo                 # a second SO-101 beside alpha
//   peppy stack join openarm_v2_sim -i bravo             # an OpenArm v2 beside them, with the browser panel
//   peppy stack join so101_sim -i delta --with mcp_commander,cameras_sim   # its front camera served over MCP
//
// MuJoCo stands one robot at a time, the robot's file being the whole
// world, so under `--with mujoco` the engine refuses a join beside alpha
// until `peppy stack remove alpha`. A join cannot turn rendering on: the
// last join above comes up where a copy named at launch selected its rig,
// as the sixth launch does, and is refused on a launch without
// one. Over MCP a model drives the SO-101's arm and gripper and sees through
// its front camera on the stack's robot_control_sim endpoint,
// http://127.0.0.1:8900/robot_control/v1/mcp, by the robot's name.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "../simulation/fragments/mujoco.json5",
        isaac_sim: "../simulation/fragments/isaac_sim.json5",
        waldo: "../simulation/fragments/waldo.json5",
      },
    },
    // The robots' MCP endpoint, off unless `--with robot_control_sim` turns
    // it on; a robot's mcp_commander option requires it. The simulated
    // robots' server reads the simulation's clock.
    {
      name: "robot_control_sim",
      cardinality: "zero_or_one",
      provides: ["robot_control_sim_inst"],
      options: {
        robot_control_sim: "../mcp/fragments/robot_control_sim.json5",
      },
    },
    // Every option of this file's simulation axis stands a so101_sim, so no
    // constraint pairs the two here: `peppy repo index --check` refuses a
    // constraint that refuses no selection. fleet.json5, whose simulation
    // axis may be unfilled, lists the simulations that stand one.
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        so101_sim: "fragments/so101_sim.json5",
        openarm_v1_sim: "../openarm/fragments/openarm_v1_sim.json5",
        openarm_v2_sim: "../openarm/fragments/openarm_v2_sim.json5",
      },
    },
  ],

  // Component deployments: the entry names the component and its option.
  // The file lists no robot: `--join OPTION:NAME` names the robots a launch
  // starts, each set up as its fragment deploys it.
  deployments: [
    { simulation: "waldo" },
  ],

  adjustments: [
    // The one server of this stack takes the documented port.
    { target: "robot_control_sim_inst", set_arguments: { port: 8900 } },
  ],
}
