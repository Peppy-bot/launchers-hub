// The MuJoCo half of a simulated robot: the engine instance the relays
// above connect to. Generation-agnostic on purpose (each base sets
// hardware_version on sim_inst for itself).
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "openarm_sim_mujoco", tag: "v1" },
      instances: [
        // cameras_enabled is off here and turned on by the sim_cameras
        // option, so a stack's camera state reads off its own selection.
        { instance_id: "sim_inst",
          arguments: { state_rate_hz: 100, cameras_enabled: false },
          // The engine is this launch's one source of simulated time: the
          // daemon hands it every machine of the launch and it publishes
          // MuJoCo's own clock to each, on the state_rate_hz cadence above.
          // Inert on a wall-time launch, which is what a daemon started
          // without `--clock-source=sim` gives you.
          framework: { publishes_sim_time: true },
          // The cameras axis owns these slots and may go unselected, so say
          // they are empty on purpose; sim_cameras unsets them when it pairs
          // its relays in.
          links: {
            wrist_left: { vacant: "the cameras axis selected no rendered cameras" },
            wrist_right: { vacant: "the cameras axis selected no rendered cameras" },
            chest: { vacant: "the cameras axis selected no rendered cameras" },
          } },
      ],
    },
  ],

  adjustments: [
    // Unguarded: skips on its own when no recorder was selected.
    { target: "recorder_inst",
      set_arguments: { storage_root: "/tmp/lerobot_openarm_mujoco" } },
  ],
}
