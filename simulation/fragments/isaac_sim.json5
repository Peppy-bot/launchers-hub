// The Isaac Sim simulation and the browser frontend for its WebRTC
// livestream. The stage opens empty and stands the robot `model` names, which
// the robot wired to these limb slots sets; robots that take a seat instead
// bring their own model, each referenced under /World as a prim of its own,
// and any number hold one at a time. Its scene_control contract takes a scene
// commander.
//
// The livestream advertises media candidates from an address it detects
// inside the container, which a browser often cannot reach. A viewer stuck on
// "waiting for stream" wants the host's own address on the network the
// browser is on, as `env_vars: { PEPPY_ISAAC_PUBLIC_IP: "..." }` on
// simulation_inst below.
{
  peppy_schema: "launcher_fragment/v1",
  deployments: [
    {
      source: { name: "openarm_sim_isaac", tag: "v1" },
      instances: [{
        instance_id: "simulation_inst",
        // Rendering is enabled by a robot's rendered camera rig. Isaac
        // publishes measured state once per rendered frame, capped at 60 Hz.
        // An empty model leaves the stage to the robots that seat themselves
        // in it; a robot on these limb slots names the model to stand.
        arguments: { cameras_enabled: false, model: "", state_rate_hz: 60 },
        links: {
          left_arm: { vacant: "a robot wired to this simulation's own limbs binds this; a seated robot binds its seat instead" },
          right_arm: { vacant: "a robot wired to this simulation's own limbs binds this; a seated robot binds its seat instead" },
          left_gripper: { vacant: "a robot wired to this simulation's own limbs binds this; a seated robot binds its seat instead" },
          right_gripper: { vacant: "a robot wired to this simulation's own limbs binds this; a seated robot binds its seat instead" },
          wrist_left: { vacant: "select cameras_sim to render this camera" },
          wrist_right: { vacant: "select cameras_sim to render this camera" },
          chest: { vacant: "select cameras_sim to render this camera" },
        },
        // In sim-time mode the simulation publishes Isaac's timeline clock
        // to each participating daemon at state_rate_hz. In wall-time mode
        // this declaration resolves to an empty participant list.
        framework: { publishes_sim_time: true },
      }],
    },
    {
      source: { name: "isaac_webviewer", tag: "v1" },
      instances: [{ instance_id: "isaac_webviewer_inst" }],
    },
  ],

  // Runtime scene and object control, selected with `--with
  // web_scene_commander` at launch.
  components: [
    {
      name: "scene_commander", cardinality: "zero_or_one",
      options: { web_scene_commander: "web_scene_commander.json5" },
    },
  ],
}
