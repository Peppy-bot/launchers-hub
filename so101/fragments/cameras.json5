// One scene camera for episode video. The launcher binds it to the
// recorder, the headset and the MCP endpoint under the robot's option, by
// the instance id written here.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // A generic UVC webcam over the front of the workspace. The instance
      // id becomes the dataset image key (observation.images.front). The
      // device path is the udev symlink ../rules/60-so101.rules pins;
      // resolution and rate are the common 720p UVC mode, retune per rig.
      source: { name: "uvc_camera_linux", tag: "v1" },
      instances: [
        {
          instance_id: "front",
          arguments: {
            device_path: "/dev/so101_front_cam",
            video: {
              frame_rate: 30,
              resolution: { width: 1280, height: 720 },
              camera_encoding: "mjpeg",
              topic_encoding: "rgb8",
            },
          },
        },
      ],
    },
  ],
}
