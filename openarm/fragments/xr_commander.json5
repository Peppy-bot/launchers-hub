// The WebXR command headset: pose-led teleop from a headset. The headset
// has no governor_control producer, so the backbone's launch-time band
// stands for the whole session; the adjustments below flip the backbone
// into pose mode and retune the cameras for in-headset panels.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: {
        name: "xr_commander",
        tag: "v1",
      },
      instances: [
        {
          // The node self-generates its TLS certificate and serves https on
          // its default port 4443; open the URL from the startup log and
          // click through the warning once. Headset-reachable only with a
          // Linux daemon: macOS runs containers in a Lima VM that does not
          // expose the port.
          instance_id: "commander_inst",
          arguments: {
            command_rate_hz: 100,
            // Rest the released trigger at half of full travel: fully open
            // splays the fingers nearly flat, wider than any grasp needs.
            gripper_open_fraction: 0.5,
          },
          links: {
            // Each hand's pose_link into the backbone's *_pose slots, the
            // arm command kind upstream_mode "pose" follows; grippers as
            // ever.
            left_arm: "backbone_inst/leader_left_arm_pose",
            right_arm: "backbone_inst/leader_right_arm_pose",
            left_gripper: "backbone_inst/leader_left_gripper",
            right_gripper: "backbone_inst/leader_right_gripper",
            // The whole-robot posture moves (A = home, B = ready).
            postures: ["backbone_inst"],
            // Per-motor health telemetry from every limb, real and sim
            // alike, listed on the status panel; each report is attributed
            // to its producing instance. Operator alerts come only from
            // real drivers, so each base adds that binding under its real
            // robot.
            motor_health: ["left_arm_inst", "right_arm_inst", "left_grip_inst", "right_grip_inst"],
          },
        },
      ],
    },
  ],

  adjustments: [
    // Pose-led teleop: the backbone solves and governs end-effector poses
    // instead of joint targets. The joint-mode vacancy annotations do not
    // apply under pose mode, so they are unset; the joint leader slots go
    // vacant instead (nothing pairs into them from a headset).
    { target: "backbone_inst",
      set_arguments: { upstream_mode: "pose" },
      set_links: {
        collision_ctrl: { vacant: "xr_commander never produces governor_control" },
        leader_left_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slots" },
        leader_right_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slots" },
      },
      unset_links: ["leader_left_arm_pose", "leader_right_arm_pose"] },

    // Panels take the Arducams as raw yuyv (half of rgb8) and the chest a
    // deeper disparity floor. Rate and resolution stay with the cameras axis:
    // this node relays at view_max_width, so wider capture only costs the
    // recorder. The cameras axis owns the instances; the consequence of
    // choosing this commander is owned here. No guard: the retunes skip on
    // their own when the cameras axis is unfilled.
    { target: "wrist_left",
      set_arguments: { video: { frame_rate: 15, resolution: { width: 960, height: 600 },
                                camera_encoding: "yuyv", topic_encoding: "yuyv" } } },
    { target: "wrist_right",
      set_arguments: { video: { frame_rate: 15, resolution: { width: 960, height: 600 },
                                camera_encoding: "yuyv", topic_encoding: "yuyv" } } },
    { target: "chest",
      set_arguments: { depth: { min_depth_m: 0.45, downscale: 2, block_size: 5 } } },
  ],
}
