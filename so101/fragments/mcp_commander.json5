// The simulated SO-101's MCP surface: no leader node at all. The server
// built into peppy serves the front_camera:v1 exposure from the MCP hub,
// one rgb camera: its latest frame to look at, its stream's properties to
// read and its brightness to set. Its one target is filled by the copy's
// rendered rig, the `front` relay, which implements rgb_camera. Its
// instance fills the commander_inst role so everything keyed on the
// robot_commander axis keeps resolving. The exposure list is fixed and the
// target takes a link, so it cannot be optional: the robot fragment
// requires its rig beside this option.
//
// A model sees through the robot's camera here and moves the robot's base
// through the simulated world's endpoint (simulation:v1, where a launcher
// serves it). The arm is not drivable over MCP: the exposure carries no
// move, and nothing streams into the backbone, whose upstream slots go
// vacant through no_commander.json5, the first part of this option.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { exposures: ["front_camera:v1"] },
      instances: [
        {
          instance_id: "commander_inst",
          // The derived node's only parameter: the port the server
          // prefers on 127.0.0.1, serving the exposure at
          // /front_camera/v1/mcp. It is a port of this robot's own, beside
          // the OpenArm commander's (8900), the brain's (8901) and the
          // simulated world's (8902), so the first SO-101 of a stack holds
          // a known URL whatever runs beside it. A copy that finds the
          // port held takes another and announces it.
          arguments: { port: 8903 },
          // One entry per target of the exposure: the camera role names
          // the rig's instance, which the resolver mints under the copy's
          // name (charlo_front).
          links: {
            front_camera: "front",
          },
        },
      ],
    },
  ],
}
