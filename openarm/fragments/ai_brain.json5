// The AI brain: the node that serves basic_actions, the environment aware
// layer above limb_motion. It leads no pairing and reaches the arms only
// through the backbone's discrete moves, so it composes with whichever
// commander was selected instead of competing with it: the operator and the
// brain send the same kind of goal to the same producer, and the governor
// sizes both on the way down.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "openarm_ai_brain", tag: "v1" },
      instances: [
        {
          instance_id: "brain_inst",
          arguments: {
            // The grippers this robot has, in the order get_state reports
            // them. The v2 bimanual arm carries one per side, under the names
            // limb_motion addresses them by.
            gripper_names: "left_gripper,right_gripper",
          },
          links: {
            // The governed producer of limb_motion. Required: a brain with no
            // arms to move is a misconfiguration, so the launch fails loudly
            // rather than starting a node that can only refuse.
            limb_motion: "backbone_inst",
          },
        },
      ],
    },
  ],
}
