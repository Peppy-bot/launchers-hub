// A simulated OpenArm v2: four relays pair the simulation's limbs onto the
// instance ids the real CAN drivers use, so the shared OpenArm control,
// its commander and its recorder keep the same links as on hardware. The
// launcher's simulation axis supplies simulation_inst. MuJoCo, Isaac Sim
// and Waldo all stand a v2 on their own limb slots, and all three render
// its camera rig there; Waldo and Isaac Sim also seat one, which is how a
// stack runs several at once.
{
  peppy_schema: "launcher_fragment/v1",

  // The robot's relays, and the option it deploys on its own axes unless a
  // copy's `with` says otherwise.
  deployments: [
    { relays: "sim_relays" },
    // The relays terminate on the simulation's own limb slots unless a copy
    // takes a seat instead.
    { wiring: "sim_limbs" },
    { control: "control_common" },
    // The commander this robot runs unless a copy's `with` selects another.
    { robot_commander: "web_commander" },
  ],

  // The robot's own axes, `one` or `zero_or_one`, filled per copy of this
  // fragment: `with: { robot_commander: "xr_commander" }` on a copy in the
  // launcher, `--with xr_commander` on `stack join`.
  components: [
    // The initializer and backbone every OpenArm shares.
    {
      name: "control", provides: ["init_inst", "backbone_inst"],
      options: { control_common: "control_common.json5" },
    },
    {
      name: "robot_commander", provides: ["commander_inst"],
      options: {
        web_commander: "web_commander.json5",
        xr_commander: "../../robot_commanders/fragments/xr_commander.json5",
        mcp_commander: "mcp_commander.json5",
      },
    },
    // The four relays that stand in for this robot's CAN drivers, wired to
    // the terminus `wiring` selects. Both live in sim_relays.json5.
    {
      name: "relays",
      provides: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"],
      options: { sim_relays: "sim_relays.json5" },
    },
    // Where those relays terminate: on the simulation's own limb slots,
    // which one robot fills, or on a seat this robot takes in a simulation
    // that hosts several.
    {
      name: "wiring",
      options: { sim_limbs: {}, sim_seat: {} },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "../../recording/fragments/lerobot_recorder.json5" },
    },
    // The three episode viewpoints as one rig, rendered by the simulation:
    // a dataset records a fixed set. Each rendered camera costs the
    // simulation a frame budget, so the rig runs only when selected.
    {
      name: "camera_rig", cardinality: "zero_or_one",
      provides: ["wrist_left", "wrist_right", "chest"],
      options: { cameras_sim: "cameras_sim.json5" },
    },
    // The environment aware action layer: the brain consumes limb_motion
    // from the backbone, so it sits beside any robot commander.
    {
      name: "brain", cardinality: "zero_or_one",
      provides: ["brain_inst", "brain_mcp_inst"],
      options: { ai_brain: "ai_brain.json5" },
    },
  ],

  constraints: [
    // A seat is held in a simulation that seats robots, which is Waldo or
    // Isaac Sim. A robot with no simulation drives its own hardware and holds
    // no seat.
    { when: { wiring: "sim_seat" },
      requires: [{ simulation: ["waldo", "isaac_sim"] }],
      reason: "a seat is held in Waldo or Isaac Sim; select one of those, or wire this robot to the simulation's own limbs with <copy>.wiring=sim_limbs" },
    // Isaac Sim renders this robot's cameras off the robot it stands, so a
    // rig there runs on the simulation's own limb slots.
    { when: { camera_rig: "cameras_sim", simulation: "isaac_sim" },
      requires: [{ wiring: "sim_limbs" }],
      reason: "Isaac Sim renders cameras off the robot it stands, not off a seat; select <copy>.wiring=sim_limbs, or drop the camera rig" },
    // The recorder and XR headset consume camera streams; the rig must feed
    // at least one of them.
    { when: { camera_rig: "cameras_sim" },
      requires: [{ recorder: "lerobot_recorder" }, { robot_commander: "xr_commander" }],
      reason: "camera streams need a consumer; select lerobot_recorder or xr_commander" },
  ],

  adjustments: [
    // Waldo's world declares the robots it stands: this robot is the one it
    // stands on its own limb slots, and a robot that takes a seat brings its
    // own model to a world that carries none.
    { target: "simulation_inst", when: { simulation: "waldo", wiring: "sim_limbs" },
      set_arguments: { world: "openarm_v2" } },
    { target: "simulation_inst", when: { simulation: "waldo", wiring: "sim_seat" },
      set_arguments: { world: "stage" } },
    // Isaac Sim opens an empty stage and stands the robot `model` names, so
    // a robot on its own limb slots is the one it names here.
    { target: "simulation_inst", when: { simulation: "isaac_sim", wiring: "sim_limbs" },
      set_arguments: { model: "openarm_v2" } },
    // The generation this robot is, which is also the model a simulation
    // stands for it when it takes a seat.
    { target: "init_inst", set_arguments: { hardware_version: "v2" } },
    // The generation the backbone governs, and a startup EE-speed cap the
    // simulation, faster than the real arm, allows.
    { target: "backbone_inst",
      set_arguments: { hardware_version: "v2", max_ee_velocity_m_s: 0.5 } },
    // Isaac publishes measured state once per rendered frame, capped at 60 Hz.
    { target: "backbone_inst", when: { simulation: "isaac_sim" },
      set_arguments: { follower_state_rate_hz: 60 } },
    // The browser panel streams the live cap the backbone follows.
    { target: "commander_inst", when: { robot_commander: "web_commander" },
      set_arguments: { max_ee_velocity_m_s: 0.5 } },
    // Dataset identity follows the simulation. /tmp lasts until reboot;
    // select durable storage for saved datasets.
    { target: "recorder_inst", when: { simulation: "mujoco" },
      set_arguments: { robot_type: "openarm_v2_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
    { target: "recorder_inst", when: { simulation: "isaac_sim" },
      set_arguments: { robot_type: "openarm_v2_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
    { target: "recorder_inst", when: { simulation: "waldo" },
      set_arguments: { robot_type: "openarm_v2_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
  ],
}
