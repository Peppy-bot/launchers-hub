// Dataset recording: the lerobot recorder plus the attachment that puts the
// record button on the XR commander when that surface was selected (the
// leader arm has no recorder slot, so the attach skips itself there).
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "lerobot_recorder", tag: "v1" },
      instances: [
        {
          instance_id: "recorder_inst",
          arguments: {
            robot_type: "so101",
            // lerobot's SO-101 dataset convention.
            fps: 30,
            // /tmp lasts until reboot; point somewhere durable for keepers.
            storage_root: "/tmp/lerobot_so101",
          },
          links: {
            // One limb: the follower's measured pairing streams are the
            // observation, the backbone's leader streams the executed action.
            // Order pairs each measured list with the commanded list at the
            // same position.
            observed_joints: ["follower_inst"],
            observed_grippers: ["follower_inst"],
            commanded_joints: ["backbone_inst/arm_link"],
            commanded_grippers: ["backbone_inst/gripper_link"],
            // The camera slots stay unbound here: the cameras fragment binds
            // into whichever recorder was selected, and a session with no
            // cameras records the limb alone.
          },
        },
      ],
    },
  ],

  adjustments: [
    // Attach the record button to the XR commander. The launcher constraint
    // already refuses a recorder beside the leader arm, so this guard never
    // fires today; it keeps the fragment self-contained rather than trusting
    // a rule declared elsewhere.
    { target: "commander_inst", when: { commander: "xr_commander" },
      add_links: { recorder: ["recorder_inst"] } },
  ],
}
