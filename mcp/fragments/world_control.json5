// The simulated world over MCP: no node at all. The server built into peppy
// serves the simulation:v1 exposure from the MCP hub as one endpoint,
// http://127.0.0.1:8902/simulation/v1/mcp. The exposure covers the scene,
// the controls of its objects, its light sources and its materials. It also
// covers a picture of the scene from any viewpoint, the simulation clock
// and where a robot can work in the scene. The server is a process of its
// own beside the stack's robot_control endpoint on port 8900. It binds the
// simulation only, so it needs nothing from any robot copy and keeps
// running when a copy is removed. Its instance id is its own, so the
// browser scene panel (web_scene_commander) runs beside it; it reads the
// simulation's clock, as that panel does. The exposure binds
// object_controls, scene_lighting, scene_materials, scene_view,
// simulation_clock and scene_workspace, which Waldo alone implements, so
// the simulation_mcp launcher, whose world_control axis deploys it,
// requires Waldo beside it; `--with world_control=none` switches it off.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { exposures: ["simulation:v1"] },
      instances: [
        {
          instance_id: "world_control_inst",
          // The derived node's only parameter: the port the server
          // prefers on 127.0.0.1, serving the exposure at
          // /simulation/v1/mcp. A server that finds the port held takes
          // another and announces it.
          arguments: { port: 8902 },
          // One entry per target of the exposure, all seven the
          // simulation's.
          links: {
            scene: "simulation_inst",
            controls: "simulation_inst",
            lighting: "simulation_inst",
            materials: "simulation_inst",
            view: "simulation_inst",
            clock: "simulation_inst",
            workspace: "simulation_inst",
          },
          framework: { clock: "simulation" },
        },
      ],
    },
  ],
}
