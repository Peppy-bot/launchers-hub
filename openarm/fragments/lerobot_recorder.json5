// An OpenArm's dataset recorder: the lerobot_recorder node deployed for this
// family, sampling both arms and both grippers onto one fps grid. Every
// OpenArm records the same four limbs at the same rate, so the rate and the
// links live here; which dataset the episodes land in depends on the
// hardware version and the engine, so the launcher names that.
//
// storage_root is bind-mounted into the recorder container; /tmp lasts until
// reboot, so name durable storage for datasets to keep. s3_uri mirrors each
// finished episode to a bucket; the node's README names the credentials it
// reads.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "lerobot_recorder", tag: "v1" },
      instances: [
        {
          instance_id: "recorder_inst",
          // Each source is sampled onto this fps grid.
          arguments: { fps: 15 },
          links: {
            // Read-only observations of each limb's measured state, in robot
            // limb order, named by the backbone's end of the pair, so the
            // dataset holds this robot's limbs and no other robot's.
            observed_joints: ["backbone_inst/left_arm", "backbone_inst/right_arm"],
            observed_grippers: ["backbone_inst/left_gripper", "backbone_inst/right_gripper"],
            // The backbone's governed commands, paired positionally with the
            // measured lists above: each action matches its follower.
            commanded_joints: ["backbone_inst/left_arm", "backbone_inst/right_arm"],
            commanded_grippers: ["backbone_inst/left_gripper", "backbone_inst/right_gripper"],
          },
        },
      ],
    },
  ],
}
