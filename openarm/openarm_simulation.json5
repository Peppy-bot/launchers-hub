// An OpenArm v2 in a simulation: the simulation is the stack, Waldo unless
// a launch word selects another, and a robot is a copy named at launch,
// `--join openarm_v2_sim:alpha`, a v2 with the browser panel, its ids
// minted under its name: alpha_backbone_inst, alpha_commander_inst. The
// file lists no copy, so a bare launch is the simulation alone; `stack
// remove` takes a copy off and `stack join` adds one, the simulation
// running throughout.
//
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha                     # Waldo and alpha, with the browser panel
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha --with mujoco       # the same copy in MuJoCo
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha --with isaac_sim,web_scene_commander
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha --with mujoco,alpha.recorder=lerobot_recorder,alpha.camera_rig=cameras_sim
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha --with robot_control_sim,alpha.mcp_commander,alpha.cameras_sim   # driven over MCP
//   peppy stack remove alpha                                       # the simulation keeps running
//
// The robot axis offers every simulated robot, so an SO-101 joins beside
// the OpenArm. Waldo and Isaac Sim stand as many robots as the machines can
// run, of any model, each joined copy bringing its own:
//
//   peppy stack launch openarm_simulation --join openarm_v2_sim:alpha --with isaac_sim
//   peppy stack join openarm_v2_sim -i bravo --with xr_commander --set-arguments commander_inst.https_port=4444
//   peppy stack join openarm_v1_sim -i charlie
//   peppy stack join so101_sim -i charlo                           # an SO-101 beside the OpenArm alpha
//   peppy stack remove bravo
//
// MuJoCo stands one robot at a time, so under `--with mujoco` the engine
// refuses a join beside alpha until `peppy stack remove alpha`. A join
// cannot turn rendering on: the simulation renders when a copy named at
// launch selects its rig, as the fourth and fifth commands above do, so an SO-101
// joined to a launch without one has no `front` camera, and `--with
// cameras_sim` on its join is refused. mcp/openarm_simulation_mcp.json5
// turns rendering on itself, and an SO-101 joined there takes its camera.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "../simulation/fragments/mujoco.json5",
        isaac_sim: "../simulation/fragments/isaac_sim.json5",
        waldo: "../simulation/fragments/waldo.json5",
      },
    },
    // The robots' MCP endpoint, off unless `--with robot_control_sim` turns
    // it on; a robot's mcp_commander option requires it. The simulated
    // robots' server reads the simulation's clock.
    {
      name: "robot_control_sim",
      cardinality: "zero_or_one",
      provides: ["robot_control_sim_inst"],
      options: {
        robot_control_sim: "../mcp/fragments/robot_control_sim.json5",
      },
    },
    // Every option of this file's simulation axis stands a so101_sim, so no
    // constraint pairs the two here: `peppy repo index --check` refuses a
    // constraint that refuses no selection. fleet.json5, whose simulation
    // axis may be unfilled, lists the simulations that stand one.
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm_v1_sim: "fragments/openarm_v1_sim.json5",
        openarm_v2_sim: "fragments/openarm_v2_sim.json5",
        so101_sim: "../so101/fragments/so101_sim.json5",
      },
    },
  ],

  // Component deployments: the entry names the component and its option.
  // The file lists no robot: `--join OPTION:NAME` names the robots a launch
  // starts, each set up as its fragment deploys it.
  deployments: [
    { simulation: "waldo" },
  ],

  adjustments: [
    // The one server of this stack takes the documented port.
    { target: "robot_control_sim_inst", set_arguments: { port: 8900 } },
  ],
}
