# The OpenArm KER leader arm (enactic), an M5Stack CoreS3 on USB.
#
# Vendor mode is what openarm_ker reads by default; the CDC device is what
# transport "serial" reads, and what flashing the firmware uses.
#
# Install:
#   sudo cp 60-openarm-ker.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   then replug the KER
#
# Verify, vendor mode (what the node reads by default):
#   lsusb -d 303a:4002                          # note its Bus and Device
#   getfacl /dev/bus/usb/<bus>/<device> | grep $USER   # your user needs rw
#
# Verify, a firmware built to stream over CDC:
#   ls -l /dev/openarm/ker
#
# Keep the 60- prefix and the TAG+="uaccess" on every matcher: the tag must
# sort before systemd's 73-seat-late.rules to grant the seat user the ACL,
# and without it the node cannot open the device it just found.
#
# Vendor 303a is Espressif, not enactic, so any Espressif board in CDC mode
# matches the tty line below and udev leaves it undefined which one keeps the
# symlink. On a host carrying other ESP32 boards, read the KER's serial with
#   udevadm info -a -n /dev/ttyACM0 | grep '{serial}'
# and add ATTRS{serial}=="..." to that matcher.

# Vendor mode: openarm_ker claims the bulk interface directly.
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4002", TAG+="uaccess"

# CDC serial mode, under a stable name for the node's device_path argument.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess", SYMLINK+="openarm/ker"
