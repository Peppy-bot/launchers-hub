// The AI brain: the node that serves item_perception and item_manipulation,
// the environment aware layer above limb_motion. It leads no pairing and reaches the arms only
// through the backbone's discrete moves, so it composes with the selected
// commander: the operator and the brain send the same kind of goal to the
// same producer, and the governor sizes both on the way down. Under the MCP
// commander the brain's tools are listed on the stack's endpoint as this
// robot's, so a model drives it by the robot's name beside the direct moves.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "openarm_ai_brain_vla", tag: "v1" },
      instances: [
        {
          instance_id: "brain_inst",
          arguments: {
            // The grippers this robot has, in the order get_state reports
            // them. The v2 bimanual arm carries one per side, under the names
            // limb_motion addresses them by.
            gripper_names: "left_gripper,right_gripper",
          },
          links: {
            // The governed producer of limb_motion. Required: a brain with no
            // arms to move is a misconfiguration, so the launch fails loudly
            // rather than starting a node that can only refuse.
            limb_motion: "backbone_inst",
            // The camera the brain looks through, optional on the node: the
            // rig that renders it binds the chest camera here
            // (cameras_sim.json5); without a rig the brain refuses both
            // searches with "no perception source" and serves the rest.
            camera: { vacant: "select cameras_sim to give the brain the chest camera" },
          },
        },
      ],
    },
  ],

  adjustments: [
    // Under the MCP commander the brain's tools are listed on the stack's
    // endpoint as this robot's: one rule for everything that moves the arms,
    // so a robot an operator drives answers no brain action.
    { target: "robot_control_inst", when: { robot_commander: "mcp_commander" },
      add_links: { item_perception: ["brain_inst"], item_manipulation: ["brain_inst"] } },
  ],
}
