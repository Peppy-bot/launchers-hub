// No command surface: an action-only session. The stack still brings up the
// backbone, so move_arm, move_arm_joints, move_gripper and the postures
// remain callable; nothing streams into the backbone's upstream slots. Those
// slots are optional pairings on so101_backbone, and an optional pairing is
// paired or declared vacant: the control fragment declares leader_pose
// vacant under joint-led teleop, and here the other two go vacant as well.
//
// The simulated robot's MCP commander streams nothing either, so its option
// lists this file as its first part and takes these vacancies from it.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [],

  adjustments: [
    { target: "backbone_inst",
      set_links: {
        leader_arm: { vacant: "nothing streams into the backbone: actions drive the arm" },
        leader_gripper: { vacant: "nothing streams into the backbone: actions drive the gripper" },
      } },
  ],
}
