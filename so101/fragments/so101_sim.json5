// A simulated SO-101: the initializer that joins the simulation as this
// robot, the backbone that leads the limbs the simulation stands, and the
// robot's own axes: an optional command surface, an optional recorder, and a
// rendered camera. There is no follower node: the engine plays the follower
// role toward the backbone, on the same pairings the real follower holds.
// Every simulation stands any number of robots at once, of any model.
//
// It comes up with no commander, so it runs on a machine with no SO-101
// hardware: a CI runner, a development host, a plain
// `peppy stack join so101_sim:charlo`, with actions driving the arm. A
// copy's `with` or a join word selects a command surface.
//
// This file writes only the instances it deploys. The launcher's simulation
// axis supplies simulation_inst, and the launcher that selects this robot
// wires it to the stack: the commander's sockets, tuning and clock, the MCP
// endpoint's slots, and the dataset the recorder files episodes under.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // The initializer every robot runs, reading the simulation's clock
      // like everything else this robot deploys.
      source: { name: "robot_initializer", tag: "v1" },
      instances: [
        {
          instance_id: "init_inst",
          framework: { clock: "simulation" },
          arguments: { model: "so101" },
          // Where this robot's limbs are: the simulation's. The initializer
          // joins it as this robot, and the simulation answers for every limb
          // it stands, so no driver fills the limbs slot.
          links: { simulation: "simulation_inst" },
        },
      ],
    },
    {
      source: { name: "so101_backbone", tag: "v1" },
      instances: [
        {
          instance_id: "backbone_inst",
          framework: { clock: "simulation" },
          arguments: {
            // Joint-led by default: the leader_arm pairing is the followed
            // upstream command (the headset block below selects "pose").
            upstream_mode: "joints",
            control_rate_hz: 60,
            // The stream's only limiter: max end-effector speed. Generous
            // for teleop feel; lower for cautious sessions. The linear cap
            // is the primary knob.
            max_ee_velocity_m_s: 2.0,
            max_ee_angular_velocity_rad_s: 12.0,
            max_gripper_rate_frac_s: 10.0,
          },
          links: {
            // The backbone leads the simulation's limb slots, one per kind of
            // limb: governed commands flow down each pair and this robot's
            // measured state returns on it. The simulation tells a pair's
            // robot by its copy and its limb by the backbone link it comes
            // from.
            arm: "simulation_inst/arms",
            gripper: "simulation_inst/grippers",
            // No leader streams by default: both sockets and the pose slot
            // stand vacant, and actions drive the arm. The adjustments below
            // release the sockets the selected leader drives, and the leader
            // pairs into them from its own fragment; the headset block
            // switches to pose mode.
            leader_arm: { vacant: "no leader streams joint commands: actions drive the arm" },
            leader_gripper: { vacant: "no leader streams joint commands: actions drive the gripper" },
            leader_pose: { vacant: "upstream_mode joints: arm commands arrive on the joint slot" },
          },
        },
      ],
    },
  ],

  // The robot's own axes, `one` or `zero_or_one`, filled per copy of this
  // fragment: `with: { robot_commander: "xr_commander" }` on a copy in the
  // launcher, `--with xr_commander` on `stack join`.
  components: [
    // Unfilled by default: the backbone's sockets stand vacant and actions
    // drive the arm.
    {
      name: "robot_commander", cardinality: "zero_or_one",
      options: {
        // A real leader arm driving the simulated follower: LeRobot data
        // without the follower. It opens /dev/so101_leader.
        so101_leader: "so101_leader.json5",
        xr_commander: "../../robot_commanders/fragments/xr_commander.json5",
        // The robot over MCP: a model drives it by name on the stack's MCP
        // endpoint.
        mcp_commander: "../../robot_commanders/fragments/mcp_commander.json5",
      },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "lerobot_recorder.json5" },
    },
    // The wrist camera, rendered by the simulation in place of the real
    // one. A rendered camera costs the simulation a frame budget, so the rig
    // runs only when selected.
    {
      name: "camera_rig", cardinality: "zero_or_one", provides: ["wrist"],
      options: { cameras_sim: "cameras_sim.json5" },
    },
  ],

  constraints: [
    // The camera stream needs a consumer: the recorder films it, the XR
    // headset shows it in its panel, and the MCP commander publishes it as
    // a resource and tools, the model its consumer. The rig must feed at
    // least one of them.
    { when: { camera_rig: "cameras_sim" },
      requires: [
        { recorder: "lerobot_recorder" },
        { robot_commander: ["xr_commander", "mcp_commander"] },
      ],
      reason: "camera streams need a consumer; select lerobot_recorder, xr_commander or mcp_commander" },
    // An episode starts via the recorder's record_episode action: from the
    // headset's button, or from the recorder.record_episode tool of the
    // stack's MCP endpoint, where the recorder is listed whenever the
    // endpoint runs.
    { when: { recorder: "lerobot_recorder" },
      requires: [{ robot_commander: "xr_commander" }, { robot_control: "robot_control" }],
      reason: "an episode starts from the XR commander's button or from recorder.record_episode on the MCP endpoint; select xr_commander or launch with robot_control" },
  ],

  adjustments: [
    // The leader arm streams joint setpoints into both sockets, released
    // here for it to pair into.
    { target: "backbone_inst", when: { robot_commander: "so101_leader" },
      unset_links: ["leader_arm", "leader_gripper"] },
    // The headset streams a pose and the gripper: the backbone follows the
    // pose slot, released here with the gripper socket for the headset to
    // pair into; the joint socket stays vacant.
    {
      target: "backbone_inst",
      when: { robot_commander: "xr_commander" },
      set_arguments: { upstream_mode: "pose" },
      unset_links: ["leader_pose", "leader_gripper"],
    },
  ],
}
