// The control every OpenArm shares: the initializer that says who the robot
// is and reports it ready once its four limbs are up, the backbone that
// governs them, and the wiring of the robot's commander and recorder into
// both. Which OpenArm it is and where its limbs are is the robot fragment's
// to say: on the initializer, the model, the instance that answers for each
// limb's readiness and the simulation the robot joins, if any; on the
// backbone, what each limb's link pairs with. The backbone names its
// downstream links after the limbs, left_arm, right_arm, left_gripper and
// right_gripper, and what is observed of the robot is named by that end of
// each pair, which is the same whatever holds the far end.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // The identity node every robot runs: it answers robot_identity with
      // the model the robot fragment names, reports the robot ready only
      // when all four of its limbs are, and joins the simulation that stands
      // a simulated robot.
      source: { name: "robot_initializer", tag: "v1" },
      instances: [ { instance_id: "init_inst" } ],
    },
    {
      source: { name: "openarm_backbone", tag: "v1" },
      instances: [
        {
          instance_id: "backbone_inst",
          // The governor band is a required node argument, as are the
          // hardware generation and the startup EE-speed cap the robot
          // fragment sets; the web panel streams live caps.
          arguments: {
            // Joint-led command pairings; the XR adjustment selects pose mode.
            upstream_mode: "joints",
            control_rate_hz: 100,
            // Match the limbs' measured-state cadence.
            follower_state_rate_hz: 100,
            d_stop_m: 0.005,
            d_safe_m: 0.02,
            collision_governor_enabled: true,
            max_ee_angular_velocity_rad_s: 0.8,
          },
          links: {
            robot_init: "init_inst",
            // The web panel supplies the operator's governor toggle. XR and
            // MCP use the backbone's launch-time settings and vacate this slot.
            collision_ctrl: "commander_inst",
            // Joint mode leaves pose slots vacant; XR pairs into them.
            leader_left_arm_pose: { vacant: "upstream_mode joints: arm commands arrive on the joint slots" },
            leader_right_arm_pose: { vacant: "upstream_mode joints: arm commands arrive on the joint slots" },
          },
        },
      ],
    },
  ],

  adjustments: [
    {
      target: "commander_inst",
      when: { robot_commander: "xr_commander" },
      // OpenArm's released trigger rests at half travel; fully opening
      // splays the fingers nearly flat. The robot owns this travel setting.
      set_arguments: { command_rate_hz: 100, gripper_open_fraction: 0.5 },
      set_links: {
        left_arm: "backbone_inst/leader_left_arm_pose",
        right_arm: "backbone_inst/leader_right_arm_pose",
        left_gripper: "backbone_inst/leader_left_gripper",
        right_gripper: "backbone_inst/leader_right_gripper",
        postures: ["backbone_inst"],
      },
    },
    {
      target: "backbone_inst",
      when: { robot_commander: "xr_commander" },
      set_arguments: { upstream_mode: "pose" },
      set_links: {
        collision_ctrl: { vacant: "xr_commander never produces governor_control" },
        leader_left_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slots" },
        leader_right_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slots" },
      },
      unset_links: ["leader_left_arm_pose", "leader_right_arm_pose"],
    },
    {
      target: "recorder_inst",
      // Each source is sampled onto this fps grid.
      set_arguments: { fps: 15 },
      set_links: {
        // Read-only observations of each limb's measured state, in robot
        // limb order, named by the backbone's end of the pair, so the
        // dataset holds this robot's limbs and no other robot's.
        observed_joints: ["backbone_inst/left_arm", "backbone_inst/right_arm"],
        observed_grippers: ["backbone_inst/left_gripper", "backbone_inst/right_gripper"],
        // Record the backbone's governed commands, paired positionally with
        // the measured lists above: each action matches its follower.
        commanded_joints: ["backbone_inst/left_arm", "backbone_inst/right_arm"],
        commanded_grippers: ["backbone_inst/left_gripper", "backbone_inst/right_gripper"],
      },
    },
  ],
}
