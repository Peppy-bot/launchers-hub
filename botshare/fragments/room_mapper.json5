// The simulated base's room mapper: it maps the rooms the base drives in
// from the lidar's scans, saves the maps by name, loads them and keeps the
// base localized in the loaded one, as room_map states, publishing the
// transform map to odom on the robot's tree. It reads the base's odometry and
// what the base is from the backbone's base_state, the lidar's frame from the
// initializer's sensor_mounts, and the lidar's place on the base from the
// transform server.
//
// This file writes only the instance it deploys: the mapper axis of
// botshare_sim.json5 selects it. That robot file supplies init_inst,
// backbone_inst, transforms_inst and, on its lidar_rig axis, the lidar, and
// adds the mapper to the publishers of the robot's tree; the launcher that
// selects the robot lists room_map's tools on the robots' MCP endpoint.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "room_mapper", tag: "v1" },
      instances: [
        {
          instance_id: "mapper_inst",
          // Every time the mapper reads, a scan's, the source timeout and
          // the grid period, is the simulation's, as the backbone's is.
          framework: { clock: "simulation" },
          arguments: {
            // The host directory the maps are saved in, which the mapper's
            // container binds: /tmp lasts until the machine restarts, as the
            // recorder's storage_root does (so101/fragments/lerobot_recorder.json5).
            maps_directory: "/tmp/room_mapper_maps",
            // Nav2 1.5.2's footprint_padding default
            // (nav2_costmap_2d/src/costmap_2d_ros.cpp:387).
            footprint_padding_m: 0.01,
            // Nav2 1.5.2's collision monitor source_timeout default
            // (nav2_collision_monitor/src/collision_monitor_node.cpp:277-278).
            source_timeout_s: 2.0,
            // slam_toolbox 2.10.0's synchronous mapping,
            // config/mapper_params_online_sync.yaml by line: 30, 28, 35, 46,
            // 31, 43-45, 47-56, 59-61, 64-66 and 69-79. The laser's ranges are
            // the lidar's own, the RPLIDAR S3's 0.05 to 40 m that the model's
            // gpu_lidar sensor gives, where the file rasters a 0 to 20 m laser
            // (lines 33-34).
            mapping: {
              map_update_interval: 5.0, throttle_scans: 1, minimum_time_interval: 0.5,
              check_min_dist_and_heading_precisely: false, min_laser_range: 0.05, max_laser_range: 40.0,
              resolution: 0.05, use_scan_barycenter: true, minimum_travel_distance: 0.5, minimum_travel_heading: 0.5,
              scan_buffer_size: 10, scan_buffer_maximum_scan_distance: 10.0, link_match_minimum_response_fine: 0.1,
              link_scan_maximum_distance: 1.5, loop_search_maximum_distance: 3.0, do_loop_closing: true,
              loop_match_minimum_chain_size: 10, loop_match_maximum_variance_coarse: 3.0,
              loop_match_minimum_response_coarse: 0.35, loop_match_minimum_response_fine: 0.45,
              correlation_search_space_dimension: 0.5, correlation_search_space_resolution: 0.01,
              correlation_search_space_smear_deviation: 0.1, loop_search_space_dimension: 8.0,
              loop_search_space_resolution: 0.05, loop_search_space_smear_deviation: 0.03,
              distance_variance_penalty: 0.5, angle_variance_penalty: 1.0, fine_search_angle_offset: 0.00349,
              coarse_search_angle_offset: 0.349, coarse_angle_resolution: 0.0349, minimum_angle_penalty: 0.9,
              minimum_distance_penalty: 0.5, use_response_expansion: true, min_pass_through: 2, occupancy_threshold: 0.1,
            },
            // slam_toolbox 2.10.0's localization mode,
            // config/mapper_params_localization.yaml:40 and 45.
            localization: { scan_buffer_size: 3, loop_match_minimum_chain_size: 3 },
            // The standard deviations within which the base is localized, as
            // measured for ROBOTCTRL-65. The matching's: above the 0.046 m to
            // 0.142 m in position and the 0.011 rad in orientation that the
            // matches of the RPLIDAR S3 keep in Waldo's two-room scene, whose
            // real errors stay under 0.02 m. The search's: the least at which
            // Nav2's AMCL handed over in every room drawn at its alphas, 0.45,
            // with one 0.05 step more.
            matching_limits: { position_std_m: 0.2, orientation_std_rad: 0.1 },
            search_limits: { position_std_m: 0.5, orientation_std_rad: 0.5 },
            // Nav2 1.5.2's AMCL, nav2_amcl/src/amcl_node.cpp by line: 943-947,
            // 955-957, 965-967, 969-970, 973, 975, 980 and 983-987; the
            // stream's random_seed is 0, the first of the seeds the room
            // recordings run Nav2's AMCL with.
            amcl: {
              random_seed: 0, alpha1: 0.2, alpha2: 0.2, alpha3: 0.2, alpha4: 0.2, alpha5: 0.2,
              laser_likelihood_max_dist: 2.0, laser_max_range: 100.0, laser_min_range: -1.0, max_beams: 60,
              max_particles: 2000, min_particles: 500, pf_err: 0.05, pf_z: 0.99, resample_interval: 1,
              robot_model_type: "nav2_amcl::DifferentialMotionModel", sigma_hit: 0.2, update_min_a: 0.2,
              update_min_d: 0.25, z_hit: 0.5, z_rand: 0.5,
            },
          },
          links: {
            // The lidar it maps from, the robot file's relay.
            lidar: "lidar",
            // The base's odometry and what the base is.
            base: "backbone_inst",
            // The lidar's frame, which must be fixed to the base.
            sensor_mounts: "init_inst",
            // The lidar's place on the base, from every publisher of the
            // robot's tree.
            transform_lookup: "transforms_inst",
          },
        },
      ],
    },
  ],
}
