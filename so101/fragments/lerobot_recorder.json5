// An SO-101's dataset recorder: the lerobot_recorder node deployed for this
// family, sampling its arm and its gripper onto one fps grid. Every SO-101
// records the same two limbs at the same rate, so the rate and the links live
// here; which dataset the episodes land in depends on the engine standing the
// robot, so the launcher names that.
//
// storage_root is bind-mounted into the recorder container; /tmp lasts until
// reboot, so name durable storage for datasets to keep. s3_uri mirrors each
// finished episode to a bucket; the node's README names the credentials it
// reads.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "lerobot_recorder", tag: "v1" },
      instances: [
        {
          instance_id: "recorder_inst",
          // The dataset grid, sampled from this robot's 60 Hz control streams.
          arguments: { fps: 30 },
          links: {
            // Read-only observations of each limb's measured state, named by
            // the backbone's end of the pair, so the dataset holds this
            // robot's limbs and no other robot's.
            observed_joints: ["backbone_inst/arm"],
            observed_grippers: ["backbone_inst/gripper"],
            // The backbone's governed commands, paired positionally with the
            // measured lists above: each action is the governed setpoint sent
            // down that pair.
            commanded_joints: ["backbone_inst/arm"],
            commanded_grippers: ["backbone_inst/gripper"],
          },
        },
      ],
    },
  ],
}
