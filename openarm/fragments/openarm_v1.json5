// A physical OpenArm v1: v1 frames and base links with prismatic
// parallel-jaw grippers, the shared OpenArm control, and the robot's own
// axes: the commander that leads it, the recorder that films it, and its
// camera rig.
// CAN topology: left arm + left gripper share can0; right arm + right
// gripper share can1. Match hardware_version and can_interface to the
// physical rig before launch.
{
  peppy_schema: "launcher_fragment/v1",

  // The robot's limbs, and the option it deploys on its own axes unless a
  // copy's `with` says otherwise.
  deployments: [
    {
      source: { name: "openarm_arm", tag: "v1" },
      instances: [
        {
          instance_id: "left_arm_inst",
          arguments: {
            arm_id: 0,
            hardware_version: "v1",
            can_interface: "can0",
            control_rate_hz: 100,
            state_rate_hz: 100,
          },
        },
        {
          instance_id: "right_arm_inst",
          arguments: {
            arm_id: 1,
            hardware_version: "v1",
            can_interface: "can1",
            control_rate_hz: 100,
            state_rate_hz: 100,
          },
        },
      ],
    },
    {
      source: { name: "openarm_gripper", tag: "v1" },
      instances: [
        {
          instance_id: "left_gripper_inst",
          arguments: {
            gripper_id: 0,
            hardware_version: "v1",
            can_interface: "can0",
            control_rate_hz: 100,
            state_rate_hz: 100,
          },
        },
        {
          instance_id: "right_gripper_inst",
          arguments: {
            gripper_id: 1,
            hardware_version: "v1",
            can_interface: "can1",
            control_rate_hz: 100,
            state_rate_hz: 100,
          },
        },
      ],
    },
    { control: "control_common" },
    // The commander this robot runs unless a copy's `with` selects another.
    { robot_commander: "web_commander" },
  ],

  // The robot's own axes, `one` or `zero_or_one`, filled per copy of this
  // fragment: `with: { robot_commander: "xr_commander" }` on a copy in the
  // launcher, `--with xr_commander` on `stack join`.
  components: [
    // The initializer and backbone every OpenArm shares.
    {
      name: "control", provides: ["init_inst", "backbone_inst"],
      options: { control_common: "control_common.json5" },
    },
    {
      name: "robot_commander",
      options: {
        web_commander: "web_commander.json5",
        xr_commander: "../../robot_commanders/fragments/xr_commander.json5",
        mcp_commander: "mcp_commander.json5",
      },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "../../recording/fragments/lerobot_recorder.json5" },
    },
    // The physical three-camera rig, installed per
    // ../rules/99-openarm-cameras.rules.
    {
      name: "camera_rig", cardinality: "zero_or_one",
      provides: ["wrist_left", "wrist_right", "chest"],
      options: { cameras: "cameras.json5" },
    },
  ],

  constraints: [
    // The camera streams need a consumer: the recorder films them, the XR
    // headset shows them in its panels, and the MCP commander publishes
    // them as resources and tools, the model its consumer. The rig must
    // feed at least one of them.
    { when: { camera_rig: "cameras" },
      requires: [
        { recorder: "lerobot_recorder" },
        { robot_commander: ["xr_commander", "mcp_commander"] },
      ],
      reason: "camera streams need a consumer; select lerobot_recorder, xr_commander or mcp_commander" },
    // The MCP commander enrolls the robot into the stack's robot_control
    // endpoint, which the launcher deploys.
    { when: { robot_commander: "mcp_commander" },
      requires: [{ robot_control: "robot_control" }],
      reason: "mcp_commander enrolls the robot into the stack's robot_control endpoint; launch with robot_control" },
  ],

  adjustments: [
    // Every robot beside the stack's robot_control endpoint is listed on it with
    // what it is and how it stands: its identity is the initializer's, and
    // its limb state and collision readout the backbone's; its brain and
    // recorder enroll whenever they run. The MCP commander adds the moves,
    // and the rig adds the cameras under that option.
    { target: "robot_control_inst",
      add_links: {
        identity: ["init_inst"],
        limb_state: ["backbone_inst"],
        collision: ["backbone_inst"],
      } },
    { target: "robot_control_inst", when: { robot_commander: "mcp_commander" },
      add_links: { postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
    { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
      add_links: { recorder: ["recorder_inst"] } },
    // Who this robot is and where its limbs are: the v1 model, and four
    // drivers of its own, each answering for its limb. It drives its own
    // hardware, so it joins no simulation.
    { target: "init_inst",
      set_links: {
        simulation: { vacant: "this robot drives its own limbs" },
        limbs: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"],
      },
      set_arguments: { model: "openarm_v1" } },
    // The backbone leads each driver: governed commands flow down each
    // pair and the limb's measured state returns on it. The generation it
    // governs, and a startup EE-speed cap conservative for physical
    // hardware.
    { target: "backbone_inst",
      set_links: {
        left_arm: "left_arm_inst",
        right_arm: "right_arm_inst",
        left_gripper: "left_gripper_inst",
        right_gripper: "right_gripper_inst",
      },
      set_arguments: { hardware_version: "v1", max_ee_velocity_m_s: 0.25 } },
    // Real drivers report per-motor health and emit operator alerts. Only
    // the web and XR commanders declare those slots.
    { target: "commander_inst", when: { robot_commander: ["web_commander", "xr_commander"] },
      add_links: {
        motor_health: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"],
        alerts: ["left_arm_inst", "right_arm_inst", "left_gripper_inst", "right_gripper_inst"],
      } },
    // The browser panel loads the v1 model.
    { target: "commander_inst", when: { robot_commander: "web_commander" },
      set_arguments: { hardware_version: "v1" } },
    // Dataset identity. /tmp lasts until reboot; select durable storage for
    // saved datasets.
    { target: "recorder_inst",
      set_arguments: { robot_type: "openarm_v1", storage_root: "/tmp/lerobot_openarm_v1" } },
  ],
}
