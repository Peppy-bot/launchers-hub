// The simulated botshare base, botshare.ai's OpenAMRobot 2.0 base: the
// initializer that joins the simulation as this robot, its backbone that
// drives the base's two wheels, the server of its tree of frames, and the
// robot's own axes, its rendered camera, its navigator, its swept lidar
// and its room mapper. The simulation plays the wheels' follower role
// toward the backbone, on joint_link, in each simulation's bases slot.
//
// base_motion's goals drive it, from the robots' MCP endpoint when the
// launcher runs one. A person drives it by hand on drive_link: through
// Waldo's drive controls, the robot_commander drive_controls, or through
// the stack's headset, which leads a base with no commander of its own and
// no navigator; and base_navigation's goals drive it through its navigator
// when the navigator axis selects one.
//
// This file writes only the instances it deploys. The launcher's simulation
// axis supplies simulation_inst, and the launcher that selects this robot
// wires it to the stack: the MCP endpoint's slots.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // The initializer every robot runs, reading the simulation's clock
      // like everything else this robot deploys.
      source: { name: "robot_initializer", tag: "v1" },
      instances: [
        {
          instance_id: "init_inst",
          framework: { clock: "simulation" },
          arguments: { model: "botshare_base" },
          // The simulation, which the initializer joins as this robot and
          // which answers for the base it stands.
          links: { simulation: "simulation_inst" },
        },
      ],
    },
    {
      source: { name: "botshare_backbone", tag: "v1" },
      instances: [
        {
          instance_id: "backbone_inst",
          // Every time the base reads, the 0.5 s a leader's setpoint holds
          // and the steps of its velocity limiter included, is the
          // simulation's.
          framework: { clock: "simulation" },
          // The base's wheels and outline come from the model the
          // initializer names, the URDF of robot_description's
          // botshare_base.
          arguments: {
            // botshare's own velocity smoother (openamr-platform-sw 69847ab,
            // openamrobot_nav2/config/nav2_params.yaml:334-348), the limits
            // botshare runs the robot at: max_velocity [0.20, 0, 0.5],
            // min_velocity [-0.20, 0, -0.5], max_accel [1.0, 0, 3.0],
            // max_decel [-2.5, 0, -3.0], deadband_velocity [0, 0, 0].
            // The rest velocity: botshare's trans_stopped_velocity
            // (nav2_params.yaml:140), the noise floor it measured on its
            // odometry's forward speed, below which its path controller
            // counts the robot as stopped, given here as the bound of each
            // wheel's measured speed. The backbone derives the turn's rest
            // rate from it and the wheel separation of its model, and the
            // base counts as at rest while its odometry reads within both.
            linear_limits: { min_velocity: -0.2, max_velocity: 0.2, max_acceleration: 1.0, max_deceleration: 2.5, deadband: 0.0, rest_velocity: 0.02 },
            angular_limits: { min_rate: -0.5, max_rate: 0.5, max_acceleration: 3.0, max_deceleration: 3.0, deadband: 0.0 },
            // botshare's smoothing_frequency (nav2_params.yaml:336), Nav2's
            // default too (velocity_smoother.cpp:51-52).
            smoothing_frequency_hz: 20.0,
            // ros2_controllers 6.9.0's velocity_rolling_window_size default
            // (diff_drive_controller/src/diff_drive_controller_parameter.yaml:
            // 119-121): 10 wheel states, 0.1 s of the 100 Hz states of Waldo
            // and MuJoCo (state_rate_hz); the adjustment below keeps the
            // 0.1 s under Isaac Sim.
            velocity_rolling_window_size: 10,
            // Nav2 1.5.2's regulated pure pursuit default
            // rotate_to_heading_min_angle
            // (nav2_regulated_pure_pursuit_controller/src/parameter_handler.cpp:
            // 104-105): past this bearing move_base's drive turns toward its
            // target again.
            rotate_to_heading_min_angle_rad: 0.785,
            // Below robot.stop's deadline_ms on the robots' MCP endpoint
            // (mcp-hub robot/robot_control.json5), 2 s, by 0.5 s for the
            // call's round trip: a stop the control loop does not answer
            // gives its own error before the call's deadline passes.
            stop_answer_timeout_s: 1.5,
            // The lookup wait: botshare's behavior_server
            // transform_tolerance (nav2_params.yaml:317), the time its Spin
            // and DriveOnHeading let tf2 wait for the robot's pose;
            // move_base turns as Spin and drives as DriveOnHeading.
            lookup_timeout_s: 0.1,
          },
          links: {
            robot_init: "init_inst",
            // The robot's model, whose description the backbone builds the
            // base from, and holds to the one it was built with.
            robot_identity: "init_inst",
            // The other publisher of the robot's tree, which places each
            // goal and setpoint: the initializer, with the fixed joints. The
            // backbone takes the transforms it publishes itself into the
            // tree.
            other_transforms: ["init_inst"],
            // The simulation stands the wheels: its bases slot holds any
            // number of pairs, and it tells a pair's robot by its copy and
            // its base by this side's link name.
            base: "simulation_inst/bases",
            // No leader drives the base until the robot_commander axis, the
            // navigator axis or the stack's headset pairs one below.
            leader_base: { vacant: "no leader drives the base: select robot_commander=drive_controls for Waldo's page, navigator=base_navigator for the navigator, or launch with xr_commander for the headset" },
          },
        },
      ],
    },
    // The robot's tree of frames, served to the nodes that hold none.
    {
      source: { name: "transform_server", tag: "v1" },
      instances: [
        {
          instance_id: "transforms_inst",
          framework: { clock: "simulation" },
          links: {
            // Every publisher of the robot's tree.
            transforms: ["init_inst", "backbone_inst"],
          },
        },
      ],
    },
    // What this robot deploys on its own axes unless a copy's `with` says
    // otherwise.
    { robot_commander: "none" },
    { camera_rig: "none" },
    { navigator: "none" },
    { lidar_rig: "none" },
    { mapper: "none" },
  ],

  components: [
    {
      // The robot's own commander, which leads the base on drive_link:
      // drive_controls, the drive controls on Waldo's page; `none` gives
      // none, and the stack's headset leads the base when the launch runs
      // one and the navigator axis selects none.
      name: "robot_commander", role: "robot_commander",
      options: {
        none: "../../common/fragments/none.json5",
        drive_controls: "drive_controls.json5",
      },
    },
    {
      // The rendered camera, the Gemini 336L (`cameras_sim`). A rendered
      // camera costs the simulation a frame budget, so the robot starts
      // without one: the option on a copy turns it on.
      name: "camera_rig",
      options: {
        none: "../../common/fragments/none.json5",
        cameras_sim: "cameras_sim.json5",
      },
    },
    {
      // The base's navigator (`base_navigator`), which drives the base
      // around what the rendered camera sees and leads it on drive_link;
      // `none` runs none, and base_motion's goals alone move the base.
      name: "navigator",
      options: {
        none: "../../common/fragments/none.json5",
        base_navigator: "base_navigator.json5",
      },
    },
    {
      // The swept lidar, the RPLIDAR S3 (`lidar_sim`). A swept lidar costs
      // the simulation its rays, so the robot starts without one: the
      // option on a copy turns it on.
      name: "lidar_rig",
      options: {
        none: "../../common/fragments/none.json5",
        lidar_sim: "lidar_sim.json5",
      },
    },
    {
      // The room mapper (`room_mapper`), which maps the rooms the base
      // drives in from the lidar, saves the maps by name and keeps the base
      // localized in the loaded one; `none` gives none.
      name: "mapper",
      options: {
        none: "../../common/fragments/none.json5",
        room_mapper: "room_mapper.json5",
      },
    },
  ],

  constraints: [
    // The camera stream needs a consumer: the robots' MCP endpoint
    // publishes it as a resource and tools, the stack's headset shows it
    // while it leads the base, and the navigator reads it into its grid.
    { when: { camera_rig: "cameras_sim" },
      requires: [{ robot_control: "robot_control" }, { teleop: "xr_commander", robot_commander: "none", navigator: "none" }, { navigator: "base_navigator" }],
      reason: "the camera needs a consumer: launch with robot_control (the MCP endpoint lists the camera), select navigator=base_navigator (the navigator's grid reads it), select robot_commander=none and launch with xr_commander (the headset shows it), or select camera_rig=none" },
    // The lidar's scans need a consumer: the room mapper maps from them.
    { when: { lidar_rig: "lidar_sim" },
      requires: [{ mapper: "room_mapper" }],
      reason: "the lidar needs a consumer: select room_mapper (it maps from the lidar's scans), or select lidar_rig=none" },
    // The room mapper maps from the lidar.
    { when: { mapper: "room_mapper" },
      requires: [{ lidar_rig: "lidar_sim" }],
      reason: "the room mapper maps from the lidar: select lidar_sim, or select mapper=none" },
    // The mapper needs a caller: the robots' MCP endpoint lists room_map's
    // tools, which start a map, save it, load one and localize the base.
    { when: { mapper: "room_mapper" },
      requires: [{ robot_control: "robot_control" }],
      reason: "the room mapper needs a caller: launch with robot_control (the MCP endpoint lists room_map's tools), or select mapper=none" },
    // The drive controls are on Waldo's page, and lead the base alone.
    { when: { robot_commander: "drive_controls" },
      requires: [{ simulation: "waldo", navigator: "none" }],
      reason: "drive_controls are on Waldo's page and lead the base alone: launch with waldo and select navigator=none, or select robot_commander=none (the navigator or the headset drives the base)" },
    // The navigator's grid reads the base's rendered camera.
    { when: { navigator: "base_navigator" },
      requires: [{ camera_rig: "cameras_sim" }],
      reason: "the navigator's grid reads the base's camera: select camera_rig=cameras_sim, or navigator=none" },
  ],

  adjustments: [
    // Waldo's drive controls lead the base: the backbone pairs into Waldo's
    // drive_controls slot, which holds any number of bases.
    { target: "backbone_inst", when: { robot_commander: "drive_controls" },
      set_links: { leader_base: "simulation_inst/drive_controls" } },
    // A robot with no commander of its own and no navigator is led by the
    // stack's headset: the backbone pairs into the headset's base slot.
    { target: "backbone_inst", when: { teleop: "xr_commander", robot_commander: "none", navigator: "none" },
      set_links: { leader_base: "headset_inst/base" } },
    // The navigator leads the base: the backbone pairs into the
    // navigator's base slot.
    { target: "backbone_inst", when: { navigator: "base_navigator" },
      set_links: { leader_base: "navigator_inst/base" } },
    // The mapper publishes map to odom on the robot's tree, so the transform
    // server takes it among the tree's publishers.
    { target: "transforms_inst", when: { mapper: "room_mapper" },
      add_links: { transforms: ["mapper_inst"] } },
    // Isaac steps its physics slower than the others: 6 of its 60 Hz wheel
    // states span the odometry's 0.1 s.
    { target: "backbone_inst", when: { simulation: "isaac_sim" },
      set_arguments: { velocity_rolling_window_size: 6 } },
  ],
}
