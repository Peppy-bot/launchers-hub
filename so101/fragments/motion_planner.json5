// An SO-101's motion planner: the node that serves motion_planning, arm paths
// planned around the objects of its planning scene and clear of the arm's own
// links. SO-101 has no depth camera, so its map stays empty. It moves nothing: a
// caller runs a plan with the backbone's execute_joint_path. A copy selects it on
// its motion_planner axis.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "motion_planner", tag: "v1" },
      instances: [
        {
          instance_id: "planner_inst",
          arguments: {
            // The most a run strays from its plan: on a real SO-101 the grasp
            // point strayed 18.8 mm at most from the rounded path over three
            // runs, a plan around a box, the plan back and a goal with a
            // tolerance. SO-101 has no guard to stand above. MoveIt pads the
            // world by 0.
            min_clearance_m: 0.02,
            // The backbone's start_tolerance_rad, so a start the backbone
            // accepts for a path can be planned from.
            start_tolerance_rad: 0.05,
            // No depth frame reaches this planner, so its map stays empty and
            // no frame is cut out: padding_scale, max_range_m and
            // max_update_rate_hz are OpenArm's, for the node's parse.
            padding_scale: 1.0,
            // At most the clearance, as OpenArm's fragment holds it.
            padding_offset_m: 0.02,
            // The empty map's grid, which the map's bounds below round out to.
            voxel_size_m: 0.02,
            max_range_m: 1.36,
            max_update_rate_hz: 5.0,
            // The extent of the arm's collision meshes over 30000 drawn
            // configurations inside its limits, for each of three seeds (x
            // -0.3473 to 0.4863, y -0.4467 to 0.4481, z -0.2338 to 0.5362; the
            // seeds agree within 5.9 mm), grown by the clearance a checked state
            // keeps (min_clearance_m + 1 mm) and rounded out to the voxel grid.
            map_min_x_m: -0.38,
            map_min_y_m: -0.48,
            map_min_z_m: -0.26,
            map_max_x_m: 0.52,
            map_max_y_m: 0.48,
            map_max_z_m: 0.56,
            // MoveIt's max_goal_samples default, the most goals its goal
            // sampler adds to a plan (moveit2 2.15.2
            // planning_context_manager.cpp:258).
            goal_samples: 10,
            // The iteration bound of public-peppy-libs' arm planning parity
            // scenario of SO-101, under which a plan's success rate lies within
            // MoveIt's; MoveIt bounds a plan by its time alone.
            max_iterations: 20000,
            // MoveIt's default num_planning_attempts.
            planning_attempts: 1,
          },
          links: {
            // Who the robot is: the initializer names its model, so101.
            identity: "init_inst",
            // The arm's measured joints and the gripper's opening.
            limb_state: "backbone_inst",
            // SO-101 carries no depth camera, and its design names no
            // perception camera.
            camera_mounts: { vacant: "SO-101 carries no perception camera" },
            workspace: { vacant: "SO-101 carries no perception camera" },
            camera: { vacant: "SO-101 has no depth camera: a plan keeps clear of the planning scene's objects" },
            geometry: { vacant: "SO-101 has no depth camera: a plan keeps clear of the planning scene's objects" },
          },
        },
      ],
    },
  ],
}
