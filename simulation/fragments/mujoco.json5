// The MuJoCo simulation. The scene opens empty: one robot joins it through
// its initializer, bringing its own model, and holds its pairs on the
// simulation's limb and camera slots; a second robot is refused while it
// stands.
{
  peppy_schema: "launcher_fragment/v1",

  // The simulation supplies the `simulation` clock: naming simulation_inst
  // its publisher assigns that instance the domain, so it carries no
  // `framework.clock` of its own. Every instance of a simulated robot binds
  // to this domain, and MuJoCo's clock is the time they all read.
  framework: { clocks: { simulation: { publisher: "simulation_inst" } } },

  deployments: [
    {
      source: { name: "openarm_sim_mujoco", tag: "v1" },
      instances: [{
        instance_id: "simulation_inst",
        // Rendering is enabled by a robot's rendered camera rig.
        arguments: { cameras_enabled: false, state_rate_hz: 100 },
      }],
    },
  ],
}
