// The WebXR command headset: pose-led teleop from one controller hand. The
// backbone solves streamed poses through the SO-101 URDF, so this fragment
// flips it into pose mode; the right-hand slots stay vacant on a single-arm
// rig.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: {
        name: "xr_commander",
        tag: "v1",
      },
      instances: [
        {
          // Self-generated TLS certificate, https on its default port 4443;
          // open the URL from the startup log and click through the warning
          // once.
          instance_id: "commander_inst",
          arguments: {
            command_rate_hz: 60,
          },
          links: {
            // The left hand drives the arm's pose slot and the gripper; the
            // right-hand slots stay vacant on this single-arm robot.
            left_arm: "backbone_inst/leader_pose",
            left_gripper: "backbone_inst/leader_gripper",
            right_arm: { vacant: "single-arm robot: only the left hand drives" },
            right_gripper: { vacant: "single-arm robot: only the left hand drives" },
            // The whole-robot posture moves (A = home, B = ready).
            postures: ["backbone_inst"],
            // Per-motor health and operator alerts from the one follower.
            motor_health: ["follower_inst"],
            alerts: ["follower_inst"],
          },
        },
      ],
    },
  ],

  adjustments: [
    // Pose-led teleop: the backbone solves and chases end-effector poses
    // instead of joint targets. The joint-mode vacancy annotation does not
    // apply under pose mode, so it is unset; the joint leader slots go
    // vacant instead (nothing pairs into them from a headset).
    { target: "backbone_inst",
      set_arguments: { upstream_mode: "pose" },
      set_links: {
        leader_arm: { vacant: "upstream_mode pose: arm commands arrive on the pose slot" },
      },
      unset_links: ["leader_pose"] },
  ],
}
