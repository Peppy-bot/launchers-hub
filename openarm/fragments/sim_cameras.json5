// The rendered counterpart of cameras.json5: the same three episode
// viewpoints and the same instance ids, so a simulated session records the
// dataset image keys a real one does (observation.images.wrist_left /
// wrist_right / chest, plus chest_depth). The frames come from the engine
// rather than USB devices, so there are no device paths and no udev rule
// here; each relay views one camera slot on the engine and presents the
// rgb_camera / rgbd_camera contract, exactly as the uvc and zed nodes do.
//
// Camera placement, intrinsics and rates live with the engine (the MuJoCo
// and Isaac engines read config/cameras.json5, and the Waldo engine
// keeps the same placement in its world manifest), taken from Enactic's
// published v2 geometry, which is why only the v2 base offers this option
// at all; its constraints enforce the rest, that the robot is simulated
// and that something in the selection consumes a camera.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      // Wrist cameras: the engine renders one Arducam viewpoint per gripper
      // and each relay republishes it.
      source: { name: "sim_rgb_camera", tag: "v1" },
      instances: [
        { instance_id: "wrist_left",  links: { engine: "sim_inst/wrist_left" } },
        { instance_id: "wrist_right", links: { engine: "sim_inst/wrist_right" } },
      ],
    },
    {
      // Chest camera: the ZED Mini viewpoint as an rgbd producer, color and
      // depth aligned because both come from one rendered camera. Stream
      // geometry and the depth floor live with the engine's cameras.json5,
      // which documents why the sim floor differs from the real node's.
      source: { name: "sim_rgbd_camera", tag: "v1" },
      instances: [
        { instance_id: "chest", links: { engine: "sim_inst/chest" } },
      ],
    },
  ],

  adjustments: [
    // Rendering costs a frame budget every frame, so the engine ships with
    // its camera slots idle and this selection is what turns them on.
    { target: "sim_inst",
      set_arguments: { cameras_enabled: true },
      // The relays below pair into these, so the engine's vacancy goes.
      unset_links: ["wrist_left", "wrist_right", "chest"] },
    // Bind into whichever recorder was selected, in the same order as the
    // real fragment so both produce the same feature order.
    { target: "recorder_inst",
      add_links: { color_cameras: ["wrist_left", "wrist_right"],
                   rgbd_cameras: ["chest"] } },
    // Shape guard: only the XR leader has camera slots of its own.
    { target: "commander_inst", when: { commander: "xr_commander" },
      add_links: { color_cameras: ["wrist_left", "wrist_right"],
                   rgbd_cameras: ["chest"] } },
  ],
}
