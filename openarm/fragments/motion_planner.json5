// An OpenArm v2's motion planner: the node that serves motion_planning, arm
// paths planned around what the chest camera sees and the objects of its
// planning scene. It keeps a map of the chest camera's depth frames in the
// robot frame, with the arms cut out at the joint positions the backbone
// measured at each frame, and plans on it. It moves nothing: a caller runs a
// plan with the backbone's execute_joint_path. A v2 copy selects it on its
// motion_planner axis; the launcher binds the rig's chest camera when the copy
// selects one.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "motion_planner", tag: "v1" },
      instances: [
        {
          instance_id: "planner_inst",
          arguments: {
            // At least the backbone's d_safe_m (0.02), where its guard leaves a
            // motion unthrottled, and the most a run strays from its plan: in
            // Waldo, six AC1 runs at full speed strayed at most 36.0 mm at an
            // arm point, at their 50 ms samples, off the path the backbone
            // runs. A state is measured against each voxel's whole box, so the
            // map adds no error there. On the robot, AC6 measures the arm's
            // drift and the ZED's error. MoveIt pads the world by 0.
            min_clearance_m: 0.04,
            // The backbone's start_tolerance_rad, so a start the backbone
            // accepts for a path can be planned from.
            start_tolerance_rad: 0.05,
            // The errors the padding covers are distances (the camera's mount,
            // a frame's stamp against the joints, the depth): the offset
            // carries them, and each piece keeps its size. MoveIt's tutorial
            // sets 1.0.
            padding_scale: 1.0,
            // At most the clearance, so an obstacle a planned arm keeps
            // min_clearance_m from never falls inside the cut-out; at least the
            // offset of the arm's own depth points from its model, 21.1 mm in
            // Waldo, the real ZED's measured at AC6. MoveIt's tutorial sets 0.1.
            // The cut-out grows each object of the planning scene by the same
            // padding, as MoveIt's depth filter does, so an item smaller than
            // 0.04 m resting on an object is avoided only as an object itself.
            padding_offset_m: 0.04,
            // Of 0.02 and 0.025 m, the voxel whose replays of the Waldo AC1
            // case plan faster on a Jetson AGX Thor at these values: 902 ms at
            // the 90th percentile against 1081, 30 each. 0.015 and 0.0125 m
            // planned slower still at a 0.03 m clearance. MoveIt falls back to
            // 0.1 m when none is set.
            voxel_size_m: 0.02,
            // The extent of either arm's collision meshes over 30000 drawn
            // configurations inside its limits, for each of three seeds (x
            // -0.603 to 0.604, y -0.762 to 0.764, z 0.0888 to 1.304; the seeds
            // agree within 5.3 mm), grown by the clearance a checked state keeps
            // (min_clearance_m + 1 mm) and rounded out to the voxel grid, which
            // adds 7.8 mm or more. An occupied voxel outside it lies farther from
            // the arms than any check reads. MoveIt's octree has no bounds.
            map_min_x_m: -0.66,
            map_min_y_m: -0.82,
            map_min_z_m: 0.04,
            map_max_x_m: 0.66,
            map_max_y_m: 0.82,
            map_max_z_m: 1.36,
            // The farthest corner of the map from the chest camera, 1.357 m:
            // every point of the map is in range. MoveIt's tutorial sets 5.
            max_range_m: 1.36,
            // The frames a second the Jetson takes into the map, one at a time:
            // in replays at these values a frame reached the map at most 176 ms
            // after the joints that cover it. The cameras give 15. MoveIt's
            // tutorial sets 1.
            max_update_rate_hz: 5.0,
            // MoveIt's max_goal_samples default, the most goals its goal
            // sampler adds to a plan (moveit2 2.15.2
            // planning_context_manager.cpp:258).
            goal_samples: 10,
            // The iteration bound of public-peppy-libs' arm planning parity
            // scenario, under which an `any` plan's success rate lies within
            // MoveIt's; MoveIt bounds a plan by its time alone.
            max_iterations: 20000,
            // MoveIt's default num_planning_attempts. On the Jetson at these
            // values, four attempts plan slower (5 of 30 replays past 1 s
            // against 2) for a 2% shorter path.
            planning_attempts: 1,
          },
          links: {
            // Who the robot is: the initializer names its model, openarm_v2.
            identity: "init_inst",
            // The arms' measured joints, where the robot's design carries the
            // chest camera, and which camera the robot perceives with: the
            // backbone answers all three.
            limb_state: "backbone_inst",
            camera_mounts: "backbone_inst",
            workspace: "backbone_inst",
            // The rig's chest camera: its depth frames and their geometry.
            // Without a rig the map stays empty, and a plan keeps clear of
            // the robot's own body and the planning scene's objects alone.
            camera: { vacant: "select the camera rig, cameras or cameras_sim, to give the planner the chest camera" },
            geometry: { vacant: "select the camera rig, cameras or cameras_sim, to give the planner the chest camera's geometry" },
          },
        },
      ],
    },
  ],
}
