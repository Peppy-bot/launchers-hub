# Stable device names for the OpenArm v2 cameras, used by the record
# launchers as device_path values (plain paths, no ':' so they survive the
# node manifests' mount_paths parsing).
#
# The two Arducam wrist cameras report identical USB serials, so the
# physical hub port is the only stable discriminator: each keeps its name
# across reboots and replugs into the SAME port, and swapping ports swaps
# identities. The ZED is matched by its unique product id and may move
# ports freely. ATTR{index}=="0" selects the capture node (index 1 is the
# UVC metadata node).
#
# Install:
#   sudo cp 99-openarm-cameras.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Verify:
#   ls -l /dev/openarm/
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="pci-0000:ad:00.0-usb-0:2.2:1.0", SYMLINK+="openarm/left_wrist_cam"
SUBSYSTEM=="video4linux", ATTR{index}=="0", ENV{ID_PATH}=="pci-0000:ad:00.0-usb-0:2.3:1.0", SYMLINK+="openarm/right_wrist_cam"
SUBSYSTEM=="video4linux", ATTR{index}=="0", ATTRS{idVendor}=="2b03", ATTRS{idProduct}=="f682", SYMLINK+="openarm/chest_cam"
