// Robots in Waldo, driven over MCP: two endpoints, one per family, split by
// whether what a model does transfers to the physical robots.
//
//   http://127.0.0.1:8900/robot_control/v1/mcp   every robot of the stack: its identity, moves, limbs, cameras, brain and recorder, each call naming its robot
//   http://127.0.0.1:8902/simulation/v1/mcp      the simulated world: the scene, its light sources, its materials
//
// Each family is deployed by the part that owns what it publishes. The
// robots' endpoint is the launcher's own robot_control_sim axis, one server for
// the whole stack; a robot enrolls into it through its mcp_commander option,
// adding its instances to the server's targets, at launch or by a later
// join, and a removal takes them out. The two URLs are the same for one
// robot or ten and before and after any join, so a client registers them
// once. The simulated world's endpoint belongs to the launcher too: an axis
// of its own, simulation_mcp, deployed here with a `none` option so a launch
// can switch it off. It is not an option of Waldo's scene_commander axis: a
// launcher cannot pre-select an axis a fragment declares, and an axis takes
// one option, so sharing that one would stop the browser scene panel from
// running beside it. Both bind the simulation or nothing, so both keep
// running when every robot is removed.
//
// The file lists no robot: each robot entry says how every copy of its
// option is set up, the MCP commander with the rendered camera rig, and the
// launch names the robots it starts with `--join OPTION:NAME`, once per
// robot, or starts none and takes them as they join. The rendered rig runs
// under every simulation, so the launcher turns the simulation's rendering
// on itself, at launch, which a join cannot: the first robot joined onto an
// empty launch gets its cameras.
//
// Waldo is the simulation the file deploys because it alone implements
// scene_lighting and scene_materials, which the world's exposure binds
// unconditionally; the constraint below refuses that option under any
// other. `--with mujoco,simulation_mcp=none` serves the robots' endpoint
// alone, the camera setters refusing where the engine has no camera
// response model. The stacks this file is meant for, and the same client on
// the real robots, are in mcp/README.md:
//
//   peppy stack launch openarm_simulation_mcp                                        # Waldo, the two endpoints, no robot yet
//   peppy stack launch openarm_simulation_mcp --join openarm_v2_sim:alpha            # one OpenArm v2, listed as alpha
//   peppy stack launch openarm_simulation_mcp --join openarm_v2_sim:alpha --join so101_sim:charlie   # an OpenArm and an SO-101
//   peppy stack launch openarm_simulation_mcp --with web_scene_commander             # the browser scene panel beside them
//   peppy stack launch openarm_simulation_mcp --with mujoco,simulation_mcp=none      # the robots' endpoint alone, under MuJoCo
//   peppy stack launch openarm_simulation_mcp --with mujoco                          # refused: the world's endpoint needs Waldo
//   peppy stack launch openarm_simulation_mcp --with robot_control_sim=none --join openarm_v2_sim:alpha --with alpha.web_commander   # the world's endpoint alone, alpha under the browser panel
//   peppy stack join openarm_v2_sim -i bravo                                         # a second OpenArm, listed on the same URL when the join returns
//   peppy stack join so101_sim -i charlie                                            # an SO-101 beside them, with its front camera
//   peppy stack join openarm_v2_sim -i delta --with ai_brain                         # an OpenArm with a brain, its brain tools on the same URL
//   peppy stack join openarm_v2_sim -i echo --with xr_commander                      # one under the headset, not over MCP
//   peppy stack remove bravo                                                         # gone from the listing when the remove returns
//
// A `--with` word on a join wins on its own axis and the entry's other axes
// stay selected, so the rendered rig runs for every robot and the robot's
// fragment asks for a consumer of its streams: `--with web_commander` alone
// is refused with that reason, and `--with web_commander,lerobot_recorder`
// is the browser panel with the recorder filming.
//
// Waldo and Isaac Sim stand any number of robots, of any model, each joined
// copy bringing its own. MuJoCo stands one robot at a time, so under
// `--with mujoco,simulation_mcp=none` the engine refuses a second copy
// until the first is removed.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "../simulation/fragments/mujoco.json5",
        isaac_sim: "../simulation/fragments/isaac_sim.json5",
        waldo: "../simulation/fragments/waldo.json5",
      },
    },
    // The robots' endpoint, on by default and switchable: a `one` axis the
    // file deploys, whose `none` option deploys nothing. The robots'
    // mcp_commander option requires it, so `--with robot_control_sim=none`
    // is the world's endpoint alone, with robots under other commanders.
    // Every robot here is simulated, so the server reads the simulation's
    // clock.
    {
      name: "robot_control_sim",
      cardinality: "one",
      options: {
        robot_control_sim: "fragments/robot_control_sim.json5",
        none: "../simulation/fragments/none.json5",
      },
    },
    // The simulated world over MCP, on by default and switchable: a `one`
    // axis the file deploys, whose `none` option deploys nothing.
    {
      name: "simulation_mcp",
      cardinality: "one",
      options: {
        mcp_scene_commander: "../simulation/fragments/mcp_scene_commander.json5",
        none: "../simulation/fragments/none.json5",
      },
    },
    // Every option of this file's simulation axis stands a so101_sim, so no
    // constraint pairs the two here: `peppy repo index --check` refuses a
    // constraint that refuses no selection. fleet.json5, whose simulation
    // axis may be unfilled, lists the simulations that stand one.
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm_v2_sim: "../openarm/fragments/openarm_v2_sim.json5",
        so101_sim: "../so101/fragments/so101_sim.json5",
      },
    },
  ],

  // A robot entry lists no copy: its `with` selects the robot's own axes
  // for every copy of the option, the ones `--join OPTION:NAME` starts with
  // the launch and the ones a join adds alike, the MCP commander with the
  // rendered rig.
  deployments: [
    { simulation: "waldo" },
    { robot_control_sim: "robot_control_sim" },
    { simulation_mcp: "mcp_scene_commander" },
    {
      robot: "openarm_v2_sim",
      with: { robot_commander: "mcp_commander", camera_rig: "cameras_sim" },
    },
    {
      robot: "so101_sim",
      with: { robot_commander: "mcp_commander", camera_rig: "cameras_sim" },
    },
  ],

  adjustments: [
    // Rendering costs a frame budget every frame, so the simulation ships
    // with its camera slots idle; the launcher turns them on, since no
    // robot of its does at launch and a join cannot.
    { target: "simulation_inst", set_arguments: { cameras_enabled: true } },
    // The one server of this stack takes the documented port.
    { target: "robot_control_sim_inst", set_arguments: { port: 8900 } },
  ],

  constraints: [
    // A property of the world's document, not of the robot: its lighting
    // and materials targets bind the simulation, and Waldo is the one
    // simulation implementing those contracts.
    { when: { simulation_mcp: "mcp_scene_commander" },
      requires: [{ simulation: "waldo" }],
      reason: "the simulated world's endpoint binds scene_lighting and scene_materials, which only waldo implements; launch with waldo or with simulation_mcp=none" },
  ],
}
