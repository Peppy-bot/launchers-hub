// A physical SO-101: the follower arm, the initializer that says who the
// robot is, the backbone that governs the arm, and the robot's own axes: the
// command surface that leads it, an optional recorder, and a camera. The
// leader arm leads unless a launch word or a copy's `with` selects another
// surface.
//
// This file writes only the instances it deploys. The launcher that selects
// this robot wires it to the stack: the commander's sockets, tuning and the
// driver's health streams, the MCP endpoint's slots, and the dataset the
// recorder files episodes under.
//
// Before first launch: install ../rules/60-so101.rules (stable serial symlinks)
// and calibrate both arms with lerobot-calibrate; the host paths below are
// where this fragment expects them. See README.md.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "so101_follower", tag: "v1" },
      instances: [
        {
          instance_id: "follower_inst",
          arguments: {
            device_path: "/dev/so101_follower",
            calibration_dir: "/var/lib/so101/calibration",
            robot_id: "follower",
            // lerobot's validated teleop rate for this bus.
            control_rate_hz: 60,
            state_rate_hz: 60,
          },
        },
      ],
    },
    {
      // The initializer every robot runs: it answers robot_identity with
      // the so101 model, the id a simulation's catalogue carries it under,
      // and robot_ready once everything that answers for the robot is up.
      // so101_backbone does not wait on it.
      source: { name: "robot_initializer", tag: "v1" },
      instances: [
        {
          instance_id: "init_inst",
          arguments: { model: "so101" },
          links: {
            // Where this robot's limbs are: one driver of its own, the
            // follower, answering for both. It drives its own hardware, so it
            // joins no simulation.
            limbs: ["follower_inst"],
            simulation: { vacant: "this robot drives its own limbs" },
          },
        },
      ],
    },
    {
      source: { name: "so101_backbone", tag: "v1" },
      instances: [
        {
          instance_id: "backbone_inst",
          arguments: {
            // Joint-led by default: the leader_arm pairing is the followed
            // upstream command (the headset adjustment below selects "pose").
            upstream_mode: "joints",
            control_rate_hz: 60,
            // The stream's only limiter: max end-effector speed. Generous
            // for teleop feel; lower for cautious sessions. The linear cap
            // is the primary knob.
            max_ee_velocity_m_s: 2.0,
            max_ee_angular_velocity_rad_s: 12.0,
            max_gripper_rate_frac_s: 10.0,
          },
          links: {
            // The exclusive command loops with the follower: governed-shape
            // setpoints stream down each pair, measured state streams back.
            arm: "follower_inst",
            gripper: "follower_inst",
            // No leader streams by default: both sockets and the pose slot
            // stand vacant, and actions drive the arm. The adjustments below
            // release the sockets the selected leader drives, and the leader
            // pairs into them from its own fragment; under the stack's
            // headset the backbone pairs its pose and gripper sockets into
            // the headset in pose mode.
            leader_arm: { vacant: "no leader streams joint commands: actions drive the arm" },
            leader_gripper: { vacant: "no leader streams joint commands: actions drive the gripper" },
            leader_pose: { vacant: "upstream_mode joints: arm commands arrive on the joint slot" },
          },
        },
      ],
    },
    // What this robot deploys on its own axes unless a copy's `with` says
    // otherwise.
    { robot_commander: "so101_leader" },
  ],

  components: [
    // No `provides`: `none` deploys nothing, and a provided id must be
    // defined by every option.
    {
      name: "robot_commander",
      options: {
        so101_leader: "so101_leader.json5",
        // No commander of its own: the stack's headset leads the arm when
        // the stack runs one, and actions alone drive it otherwise.
        none: "../../common/fragments/none.json5",
      },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "lerobot_recorder.json5" },
    },
    {
      name: "camera_rig", cardinality: "zero_or_one", provides: ["wrist"],
      options: { cameras: "cameras.json5" },
    },
  ],

  constraints: [
    // The camera stream needs a consumer: the recorder films it, the
    // stack's headset shows it in its panel, and the robots' MCP endpoint
    // publishes it as a resource and tools, the model its consumer. The rig
    // must feed at least one of them.
    { when: { camera_rig: "cameras" },
      requires: [
        { recorder: "lerobot_recorder" },
        { robot_control: "robot_control" },
        { teleop: "xr_commander", robot_commander: "none" },
      ],
      reason: "the camera needs a consumer: select lerobot_recorder, or launch with robot_control (the MCP endpoint lists the camera), or select robot_commander=none and launch with xr_commander (the headset shows it)" },
    // An episode starts via the recorder's record_episode action: from the
    // headset's button, or from the recorder.record_episode tool of the
    // stack's MCP endpoint, where the recorder is listed whenever the
    // endpoint runs.
    { when: { recorder: "lerobot_recorder" },
      requires: [{ teleop: "xr_commander", robot_commander: "none" }, { robot_control: "robot_control" }],
      reason: "the recorder needs a trigger: select robot_commander=none and launch with xr_commander (the headset's record button), or launch with robot_control (recorder.record_episode on the MCP endpoint)" },
  ],

  adjustments: [
    // The leader arm streams joint setpoints into both sockets, released
    // here for it to pair into.
    { target: "backbone_inst", when: { robot_commander: "so101_leader" },
      unset_links: ["leader_arm", "leader_gripper"] },
    // A robot with no commander of its own is led by the stack's headset's
    // right hand: the backbone follows the pose slot, paired with the
    // gripper socket into the headset's right slots; the joint socket stays
    // vacant.
    {
      target: "backbone_inst",
      when: { teleop: "xr_commander", robot_commander: "none" },
      set_arguments: { upstream_mode: "pose" },
      set_links: { leader_pose: "headset_inst/right_arm", leader_gripper: "headset_inst/right_gripper" },
    },
  ],
}
