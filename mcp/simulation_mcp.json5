// Robots in Waldo driven over MCP: three endpoints, one per family, over a
// simulation that starts with no robot, and the robots named at launch,
// joined later or added over MCP, each driven over MCP with its rendered
// rig. A call to the framework, to the simulated world and to a robot each
// goes to its own endpoint:
//
//   http://127.0.0.1:8903/framework_controls/v1/mcp   the peppy framework: the stack of nodes, where a client adds a robot of this file's options and removes it
//   http://127.0.0.1:8902/simulation/v1/mcp           the simulated world: the scene, its objects' controls, its light sources, its materials, its views, its clock, where a robot can work in it
//   http://127.0.0.1:8900/robot_control/v1/mcp        every robot of the stack: its identity, moves, limbs, cameras, workspace, brain and recorder, each call naming its robot
//
// The robots' endpoint is the robot_control axis every launcher with robots
// carries; this file deploys it, and the other launchers serve it with
// `--with robot_control`. Every robot beside it is listed with its identity,
// its limb state and where its design lets it work, and with its recorder
// whenever it runs; its mcp_commander option adds the moves, its rig the
// cameras and its brain the brain's tools, at launch or by a later join, and
// a removal takes them out. The framework's endpoint comes with it, on the
// same option of this file alone: stack.list, stack.join and stack.remove
// add and remove the robots of the scope the adjustment below gives, the
// two robot options of this file, up to four robots on the stack. The
// world's endpoint is this file's own world_control axis, deployed with a
// `none` option: Waldo alone implements the object controls, lighting,
// materials, view, clock and workspace contracts it binds, so the
// constraint below refuses it under any other engine, and `--with
// mujoco,world_control=none` is the robots' and the framework's endpoints
// under MuJoCo. The three URLs are the same with no robot, one or ten and
// before and after any join, so a client registers them once, and all three
// run while no robot stands in the simulation.
//
// What this file adds to openarm_simulation: the robots' and the
// framework's endpoints deployed, the world's endpoint on its own axis,
// rendering on from the launch, no robot listed, and its robot entries: for
// each option the MCP commander and the rendered rig, so every robot named
// on the command line, at launch with `--join OPTION:NAME` or later with a
// plain `stack join`, and every robot stack.join adds, comes up driven over
// MCP with its cameras, listed on the same URL when the join returns. A
// launch or a join of a simulated robot returns only once the simulation
// stands the robot. A robot that stack.join adds stands on a free floor
// spot, and workspace.stand_at on the world's endpoint stands it at a work
// surface. A v1 OpenArm, which the simulations render no rig for, joins with
// `--with v1,camera_rig=none`. The stacks this file is meant for, and the
// same client on the real robots, are in mcp/README.md:
//
//   peppy stack launch simulation_mcp                                    # Waldo and the three endpoints, no robot
//   peppy stack launch simulation_mcp --join openarm_sim:alpha           # an OpenArm v2 over MCP
//   peppy stack launch simulation_mcp --join openarm_sim:alpha,so101_sim:charlie   # an OpenArm and an SO-101
//   peppy stack launch simulation_mcp --with mujoco,world_control=none   # the robots' and the framework's endpoints, under MuJoCo
//   peppy stack join openarm_sim:bravo                                   # an OpenArm, on the same URL when the join returns
//   peppy stack remove alpha                                             # the endpoints keep running
//
// A `--with` word on a join wins on its own axis and the entry's other axes
// stay selected: `--with xr_commander` is a headset robot with the rig
// feeding its panels. `--join openarm_sim:alpha --with
// robot_control=none,alpha.web_commander,alpha.lerobot_recorder` on the
// launch is the world's endpoint alone, alpha under the browser panel with
// the recorder filming its rig; a joined robot needs a commander word too,
// since mcp_commander requires the robots' endpoint.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "../simulation/fragments/mujoco.json5",
        isaac_sim: "../simulation/fragments/isaac_sim.json5",
        waldo: "../simulation/fragments/waldo.json5",
      },
    },
    // The robots' MCP endpoint, and the framework's endpoint that adds and
    // removes the robots it drives; `--with robot_control=none` switches
    // both off. Every robot is listed on the robots' endpoint, and a robot's
    // mcp_commander option adds its moves and requires it.
    {
      name: "robot_control",
      cardinality: "one",
      options: {
        robot_control: {
          fragments: ["fragments/framework_controls.json5", "fragments/robot_control.json5"],
        },
        none: "../common/fragments/none.json5",
      },
    },
    // The simulated world's MCP endpoint, deployed by this file; `--with
    // world_control=none` switches it off. It binds Waldo's object controls,
    // lighting, materials, view, clock and workspace contracts, so the
    // constraint below requires Waldo.
    {
      name: "world_control",
      cardinality: "one",
      options: {
        world_control: "fragments/world_control.json5",
        none: "../common/fragments/none.json5",
      },
    },
    // Every simulated robot, an option of the same name in every simulation
    // launcher. Every simulation stands any number of them, of any model.
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm_sim: {
          fragments: ["../openarm/fragments/openarm_sim.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure,
            // how close its arms stand, where its cameras are mounted and
            // where its design lets it work.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], collision: ["backbone_inst"],
                           camera_mounts: ["backbone_inst"], workspace: ["backbone_inst"] } },
            // The headset leads from the pose sockets; a released trigger rests
            // at half travel, since fully open splays the fingers nearly flat.
            { target: "commander_inst", when: { robot_commander: "xr_commander" },
              set_arguments: { command_rate_hz: 100, gripper_open_fraction: 0.5 },
              set_links: {
                left_arm: "backbone_inst/leader_left_arm_pose",
                right_arm: "backbone_inst/leader_right_arm_pose",
                left_gripper: "backbone_inst/leader_left_gripper",
                right_gripper: "backbone_inst/leader_right_gripper",
                postures: ["backbone_inst"],
              } },
            // The panel streams the live cap the simulated backbone starts on.
            { target: "commander_inst", when: { robot_commander: "web_commander" },
              set_arguments: { max_ee_velocity_m_s: 0.5 } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity, by hardware version and engine.
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "mujoco" },
              set_arguments: { robot_type: "openarm_v1_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "isaac_sim" },
              set_arguments: { robot_type: "openarm_v1_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
            { target: "recorder_inst", when: { hardware_version: "v1", simulation: "waldo" },
              set_arguments: { robot_type: "openarm_v1_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "mujoco" },
              set_arguments: { robot_type: "openarm_v2_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "isaac_sim" },
              set_arguments: { robot_type: "openarm_v2_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
            { target: "recorder_inst", when: { hardware_version: "v2", simulation: "waldo" },
              set_arguments: { robot_type: "openarm_v2_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
            // Under the MCP commander, the moves a model drives it by.
            { target: "robot_control_inst", when: { robot_commander: "mcp_commander" },
              add_links: { postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The brain's tools, under the same commander as the moves.
            { target: "robot_control_inst", when: { brain: "ai_brain_vla", robot_commander: "mcp_commander" },
              add_links: { item_perception: ["brain_inst"], item_manipulation: ["brain_inst"] } },
            // The simulated robot's brain sees: the simulation runs where a
            // GPU is, so it finds and names items with the local SAM 3 and
            // SigLIP pipeline, by words from the node's general vocabulary,
            // looking through the chest camera the rendered rig binds, color
            // and depth from one producer.
            { target: "brain_inst", when: { brain: "ai_brain_vla" },
              set_arguments: { perception_backend: "sam3_siglip" } },
            { target: "brain_inst", when: { brain: "ai_brain_vla", camera_rig: "cameras_sim" },
              set_links: { camera: "chest", geometry: "chest" } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // The headset shows the rig in its panels.
            { target: "commander_inst", when: { camera_rig: "cameras_sim", robot_commander: "xr_commander" },
              add_links: { color_cameras: ["wrist_left", "wrist_right"], rgbd_cameras: ["chest"] } },
            // Listed on the MCP endpoint with profile and geometry.
            { target: "robot_control_inst", when: { camera_rig: "cameras_sim", robot_commander: "mcp_commander" },
              add_links: { camera: ["wrist_left", "wrist_right"], depth_camera: ["chest"],
                           camera_profile: ["wrist_left", "wrist_right", "chest"],
                           camera_geometry: ["wrist_left", "wrist_right", "chest"] } },
            // The commander, recorder and brain are shared with the physical robot.
            { target: "commander_inst", set_framework: { clock: "simulation" } },
            { target: "recorder_inst", set_framework: { clock: "simulation" } },
            { target: "brain_inst", set_framework: { clock: "simulation" } },
          ],
        },
        so101_sim: {
          fragments: ["../so101/fragments/so101_sim.json5"],
          adjustments: [
            // Listed on the MCP endpoint: who it is, what its limbs measure and
            // where its design lets it work.
            { target: "robot_control_inst",
              add_links: { identity: ["init_inst"], limb_state: ["backbone_inst"], workspace: ["backbone_inst"] } },
            // The headset leads from the pose socket; only the right hand drives
            // a single-arm robot.
            { target: "commander_inst", when: { robot_commander: "xr_commander" },
              set_arguments: { command_rate_hz: 60, gripper_open_fraction: 0.5 },
              set_links: {
                right_arm: "backbone_inst/leader_pose",
                right_gripper: "backbone_inst/leader_gripper",
                left_arm: { vacant: "single-arm robot: only the right hand drives" },
                left_gripper: { vacant: "single-arm robot: only the right hand drives" },
                postures: ["backbone_inst"],
              } },
            // An episode also starts from the MCP endpoint.
            { target: "robot_control_inst", when: { recorder: "lerobot_recorder" },
              add_links: { recorder: ["recorder_inst"] } },
            // Dataset identity, by engine.
            { target: "recorder_inst", when: { simulation: "mujoco" },
              set_arguments: { robot_type: "so101_mujoco", storage_root: "/tmp/lerobot_so101_mujoco" } },
            { target: "recorder_inst", when: { simulation: "isaac_sim" },
              set_arguments: { robot_type: "so101_isaac", storage_root: "/tmp/lerobot_so101_isaac" } },
            { target: "recorder_inst", when: { simulation: "waldo" },
              set_arguments: { robot_type: "so101_waldo", storage_root: "/tmp/lerobot_so101_waldo" } },
            // Under the MCP commander, the moves a model drives it by.
            { target: "robot_control_inst", when: { robot_commander: "mcp_commander" },
              add_links: { postures: ["backbone_inst"], limb_motion: ["backbone_inst"] } },
            // The recorder films the rig; binding order fixes the dataset's
            // feature order.
            { target: "recorder_inst", when: { camera_rig: "cameras_sim" },
              add_links: { color_cameras: ["wrist"] } },
            // The headset shows the rig in its panels.
            { target: "commander_inst", when: { camera_rig: "cameras_sim", robot_commander: "xr_commander" },
              add_links: { color_cameras: ["wrist"] } },
            // Listed on the MCP endpoint with profile and geometry.
            { target: "robot_control_inst", when: { camera_rig: "cameras_sim", robot_commander: "mcp_commander" },
              add_links: { camera: ["wrist"], camera_profile: ["wrist"], camera_geometry: ["wrist"] } },
            // The commander and recorder are shared with the physical robot.
            { target: "commander_inst", set_framework: { clock: "simulation" } },
            { target: "recorder_inst", set_framework: { clock: "simulation" } },
          ],
        },
      },
    },
  ],

  // An entry's `with` selects the robot's own axes for every copy of the
  // option, and no entry lists a copy, so the bare launch stands no robot:
  // every copy named on the command line, at launch with `--join
  // OPTION:NAME` or later with `stack join`, and every copy stack.join adds
  // on the framework's endpoint, runs the MCP commander and films.
  deployments: [
    { simulation: "waldo" },
    { robot_control: "robot_control" },
    { world_control: "world_control" },
    {
      robot: "openarm_sim",
      // A v1, which the simulations render no rig for, joins with
      // `stack join openarm_sim:bravo --with v1,camera_rig=none`.
      with: { robot_commander: "mcp_commander", camera_rig: "cameras_sim" },
    },
    {
      robot: "so101_sim",
      with: { robot_commander: "mcp_commander", camera_rig: "cameras_sim" },
    },
  ],

  adjustments: [
    // Every engine renders a camera only while a robot holds its pair, so
    // rendering is on from the launch and a joined robot's rig comes up.
    { target: "simulation_inst", set_arguments: { cameras_enabled: true } },
    // The server reads the simulation's clock, as every instance a robot
    // copy runs does; each simulated robot's fragment binds its own.
    { target: "robot_control_inst", set_framework: { clock: "simulation" } },
    // The robots a client of the framework's endpoint can add: each robot
    // option of this file, with one line for the client that says what the
    // robot is and how it stands, since no tool reports a stance before the
    // robot stands, up to four robots on the stack. Every copy renders its
    // cameras, and a furnished scene has three work surfaces 1.5 m apart.
    { target: "framework_controls_inst",
      set_daemon_scopes: { stack: {
        max_copies: 4,
        options: [
          { option: "openarm_sim",
            description: "A simulated OpenArm v2 standing on the floor: two 7-joint arms with grippers on a stand, a depth camera on its chest and a camera on each wrist" },
          { option: "so101_sim",
            description: "A simulated SO-101 clamped on the edge of a table: one arm with a gripper and a camera on its wrist" },
        ],
      } } },
  ],

  constraints: [
    // A property of the world's document: its controls, lighting,
    // materials, view, clock, workspace and reset targets bind the
    // simulation, and Waldo is the one simulation implementing those
    // contracts.
    { when: { world_control: "world_control" },
      requires: [{ simulation: "waldo" }],
      reason: "the simulated world's endpoint binds object_controls, scene_lighting, scene_materials, scene_view, simulation_clock, scene_workspace and simulation_reset, which only waldo implements; launch with waldo or with world_control=none" },
  ],
}
