// The MCP command surface: no leader node at all. The server built into
// peppy serves the openarm_v2:v1 exposure from the MCP hub, the robot's own
// surface: its identity target filled by the robot's initializer, its two
// move targets by the backbone and its three camera targets by the copy's
// rig, the physical rig on hardware and the rendered one in simulation,
// under the same ids. Its instance fills the
// commander_inst role so everything keyed on the robot_commander axis keeps
// resolving. The exposure list is fixed and every target takes a link, so
// the camera targets cannot be optional: the robot fragment requires its
// rig beside this option. Nothing streams: every move is a discrete action
// the backbone runs itself, so the backbone's leader sockets and its
// governor-control slot go vacant below.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { exposures: ["openarm_v2:v1"] },
      instances: [
        {
          instance_id: "commander_inst",
          // The derived node's only parameter: the port the server
          // prefers on 127.0.0.1, serving the exposure at
          // /openarm_v2/v1/mcp. A copy that finds the port held takes
          // another and announces it.
          arguments: { port: 8900 },
          // One entry per target of the exposure. The identity role is
          // the initializer's and the two move roles are the backbone's,
          // the same instances under the real robot and every simulation;
          // the camera roles name the rig's instances, which the resolver
          // mints under the copy's name (alpha_wrist_left) as it does the
          // initializer and the backbone.
          links: {
            identity: "init_inst",
            postures: "backbone_inst",
            limb_motion: "backbone_inst",
            wrist_left: "wrist_left",
            wrist_right: "wrist_right",
            chest: "chest",
          },
        },
      ],
    },
  ],

  adjustments: [
    // The MCP server never pairs into the backbone: arm and gripper moves
    // arrive as limb_motion actions and posture moves as postures actions,
    // so the four sockets a leader would fill under joint-led teleop are
    // vacated (upstream_mode stays "joints"; the robot fragment already
    // vacates the two pose sockets). It never produces governor_control
    // either, so the backbone's launch-time band, enable, and EE-speed caps
    // stand for the whole session, exactly as under the headset.
    { target: "backbone_inst",
      set_links: {
        collision_ctrl: { vacant: "the MCP commander never produces governor_control" },
        leader_left_arm: { vacant: "the MCP commander streams nothing: arm moves arrive as limb_motion actions" },
        leader_right_arm: { vacant: "the MCP commander streams nothing: arm moves arrive as limb_motion actions" },
        leader_left_gripper: { vacant: "the MCP commander streams nothing: gripper moves arrive as limb_motion actions" },
        leader_right_gripper: { vacant: "the MCP commander streams nothing: gripper moves arrive as limb_motion actions" },
      } },
  ],
}
