// A simulated OpenArm v2: the shared OpenArm control, with the simulation
// standing its limbs. The launcher's simulation axis supplies
// simulation_inst; this robot's initializer joins it, naming the copy the
// robot runs as and the v2 model to stand, and the backbone leads the
// simulation's limb slots on the same pairings it leads a real robot's
// drivers. Isaac Sim and Waldo stand as many robots as their machines can
// run, one pair per robot on those slots; MuJoCo stands one.
{
  peppy_schema: "launcher_fragment/v1",

  // The option this robot deploys on its own axes unless a copy's `with`
  // says otherwise.
  deployments: [
    { control: "control_common" },
    // The commander this robot runs unless a copy's `with` selects another.
    { robot_commander: "web_commander" },
  ],

  // The robot's own axes, `one` or `zero_or_one`, filled per copy of this
  // fragment: `with: { robot_commander: "xr_commander" }` on a copy in the
  // launcher, `--with xr_commander` on `stack join`.
  components: [
    // The initializer and backbone every OpenArm shares.
    {
      name: "control", provides: ["init_inst", "backbone_inst"],
      options: { control_common: "control_common.json5" },
    },
    // mcp_commander is the robot's own MCP surface, the one the real robot
    // has: its moves beside its three cameras, which the rendered rig fills
    // here. The simulated world's MCP endpoint is not this robot's: the
    // launcher that serves it deploys it (mcp/openarm_simulation_mcp.json5).
    {
      name: "robot_commander", provides: ["commander_inst"],
      options: {
        web_commander: "web_commander.json5",
        xr_commander: "../../robot_commanders/fragments/xr_commander.json5",
        mcp_commander: "mcp_commander.json5",
      },
    },
    {
      name: "recorder", cardinality: "zero_or_one", provides: ["recorder_inst"],
      options: { lerobot_recorder: "../../recording/fragments/lerobot_recorder.json5" },
    },
    // The three episode viewpoints as one rig, rendered by the simulation:
    // a dataset records a fixed set. Each rendered camera costs the
    // simulation a frame budget, so the rig runs only when selected.
    {
      name: "camera_rig", cardinality: "zero_or_one",
      provides: ["wrist_left", "wrist_right", "chest"],
      options: { cameras_sim: "cameras_sim.json5" },
    },
    // The environment aware action layer: the brain consumes limb_motion
    // from the backbone, so it sits beside any robot commander.
    {
      name: "brain", cardinality: "zero_or_one",
      provides: ["brain_inst", "brain_mcp_inst"],
      options: { ai_brain_vla: "ai_brain_vla.json5" },
    },
  ],

  constraints: [
    // The camera streams need a consumer: the recorder films them, the XR
    // headset shows them in its panels, the MCP commander publishes them
    // as resources and tools, the model its consumer, and the brain looks
    // through the chest camera to find items. The rig must
    // feed at least one of them. The browser scene commander lists them in
    // its camera panel too, but its axis belongs to the simulation's
    // fragment, not to this robot's or the launcher's, so a constraint here
    // cannot name it: the resolver refuses `scene_commander` as not in
    // reach. A rig meant for that panel alone selects one of the consumers
    // above beside it.
    { when: { camera_rig: "cameras_sim" },
      requires: [
        { recorder: "lerobot_recorder" },
        { robot_commander: ["xr_commander", "mcp_commander"] },
        { brain: "ai_brain_vla" },
      ],
      reason: "camera streams need a consumer; select lerobot_recorder, xr_commander, mcp_commander or ai_brain_vla" },
    // The MCP commander's exposure list is fixed and every target takes a
    // link, so its camera targets cannot be optional: the rendered rig
    // must run beside it.
    { when: { robot_commander: "mcp_commander" },
      requires: [{ camera_rig: "cameras_sim" }],
      reason: "mcp_commander serves the robot's cameras and its exposure list is fixed, so the camera targets cannot be optional; select cameras_sim" },
  ],

  adjustments: [
    // Everything this robot runs reads the simulation's clock. The control,
    // commander, recorder and brain fragments are shared with the physical
    // robot, so this robot binds the instances they deploy; the camera rig is
    // the simulation's own and declares the clock on its instances.
    { target: "init_inst", set_framework: { clock: "simulation" } },
    { target: "backbone_inst", set_framework: { clock: "simulation" } },
    { target: "commander_inst", set_framework: { clock: "simulation" } },
    { target: "recorder_inst", set_framework: { clock: "simulation" } },
    { target: "brain_inst", set_framework: { clock: "simulation" } },
    { target: "brain_mcp_inst", set_framework: { clock: "simulation" } },
    // Where this robot's limbs are: the simulation's. The initializer joins
    // it as this robot, a v2, and it answers for every limb it stands.
    { target: "init_inst",
      set_links: { simulation: "simulation_inst" },
      set_arguments: { hardware_version: "v2" } },
    // The backbone leads the simulation's limb slots: governed commands
    // flow down each pair and this robot's measured state returns on it.
    // It governs a v2, with a startup EE-speed cap the simulation, faster
    // than the real arm, allows.
    { target: "backbone_inst",
      set_links: {
        left_arm_link: "simulation_inst/left_arm",
        right_arm_link: "simulation_inst/right_arm",
        left_gripper_link: "simulation_inst/left_gripper",
        right_gripper_link: "simulation_inst/right_gripper",
      },
      set_arguments: { hardware_version: "v2", max_ee_velocity_m_s: 0.5 } },
    // Isaac publishes measured state once per rendered frame, capped at 60 Hz.
    { target: "backbone_inst", when: { simulation: "isaac_sim" },
      set_arguments: { follower_state_rate_hz: 60 } },
    // The browser panel streams the live cap the backbone follows.
    { target: "commander_inst", when: { robot_commander: "web_commander" },
      set_arguments: { max_ee_velocity_m_s: 0.5 } },
    // Dataset identity follows the simulation. /tmp lasts until reboot;
    // select durable storage for saved datasets.
    { target: "recorder_inst", when: { simulation: "mujoco" },
      set_arguments: { robot_type: "openarm_v2_mujoco", storage_root: "/tmp/lerobot_openarm_mujoco" } },
    { target: "recorder_inst", when: { simulation: "isaac_sim" },
      set_arguments: { robot_type: "openarm_v2_isaac", storage_root: "/tmp/lerobot_openarm_isaac" } },
    { target: "recorder_inst", when: { simulation: "waldo" },
      set_arguments: { robot_type: "openarm_v2_waldo", storage_root: "/tmp/lerobot_openarm_waldo" } },
  ],
}
