// Any mix of robots, physical and simulated, assembled from the command
// line: this file deploys nothing. A simulation is selected at launch, and
// every robot is a copy added with `stack join`, its ids minted under its
// name: alpha_backbone_inst, alpha_commander_inst.
//
//   peppy stack launch fleet                                # no simulation
//   peppy stack join openarm_v2 -i alpha --place jetson-1
//   peppy stack join so101 -i bravo
//
//   peppy stack launch fleet --with mujoco
//   peppy stack join openarm_v2_sim -i alpha --with xr_commander
//   peppy stack join openarm_v1 -i bravo --place jetson-2
//   peppy stack remove alpha
//
//   peppy stack launch fleet --with isaac_sim
//   peppy stack join openarm_v2_sim -i alpha
//   peppy stack join openarm_v1_sim -i bravo
//
// A simulated robot refuses to join without a simulation. Waldo and Isaac
// Sim stand any number of robots at once, each joined copy bringing its own
// model; MuJoCo stands one.
{
  peppy_schema: "launcher/v1",

  components: [
    {
      name: "simulation",
      cardinality: "zero_or_one",
      provides: ["simulation_inst"],
      options: {
        mujoco: "simulation/fragments/mujoco.json5",
        isaac_sim: "simulation/fragments/isaac_sim.json5",
        waldo: "simulation/fragments/waldo.json5",
      },
    },
    {
      name: "robot",
      cardinality: "zero_or_more",
      options: {
        openarm_v1: "openarm/fragments/openarm_v1.json5",
        openarm_v2: "openarm/fragments/openarm_v2.json5",
        openarm_v1_sim: "openarm/fragments/openarm_v1_sim.json5",
        openarm_v2_sim: "openarm/fragments/openarm_v2_sim.json5",
        so101: "so101/fragments/so101.json5",
      },
    },
  ],

  deployments: [],

  constraints: [
    // A simulated robot of either generation runs in any simulation, so its
    // need for one is stated here, where the simulation axis may be unfilled.
    { when: { robot: ["openarm_v1_sim", "openarm_v2_sim"] },
      requires: [{ simulation: ["mujoco", "isaac_sim", "waldo"] }],
      reason: "a simulated robot needs a simulation; launch with mujoco, isaac_sim or waldo" },
  ],
}
