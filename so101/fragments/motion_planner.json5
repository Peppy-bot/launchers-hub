// An SO-101's motion planner. It plans arm paths around the objects of the
// planning scene and keeps the arm's links apart. It moves nothing: a caller runs
// a plan with the backbone's execute_joint_path. SO-101 has no depth camera, so
// the planner's map stays empty and the scene's objects are all it plans around.
// A copy selects this fragment on its motion_planner axis.
{
  peppy_schema: "launcher_fragment/v1",

  deployments: [
    {
      source: { name: "motion_planner", tag: "v1" },
      instances: [
        {
          instance_id: "planner_inst",
          arguments: {
            // How far a plan keeps the arm from the scene's objects, and the
            // arm's links from each other. MoveIt's default: it pads neither
            // (moveit2 2.15.2: default_robot_padding, planning_scene_monitor.cpp:1672;
            // pad_self_collisions, collision_common.hpp:157). Every state of a
            // plan keeps 1 mm more, 2 mm between two links, so the planner can
            // prove the motion between states clear.
            min_clearance_m: 0.0,
            // How far a start may sit outside a joint limit: the backbone's
            // start_tolerance_rad, so every start the backbone runs a path
            // from can be planned from.
            start_tolerance_rad: 0.05,
            // Depth camera settings. They do nothing on SO-101, which has no
            // depth camera; the node needs a value for each. padding_scale,
            // max_range_m and max_update_rate_hz are OpenArm's.
            padding_scale: 1.0,
            // Does nothing on SO-101, which has no depth camera; the node needs a
            // value. On a robot with one, the planner erases the depth points
            // within this distance of the robot's own body, so the camera's view
            // of the arm is not mapped as an obstacle. It is at most
            // min_clearance_m, so the erased band never hides an obstacle a plan
            // keeps clear of.
            padding_offset_m: 0.0,
            max_range_m: 1.36,
            max_update_rate_hz: 5.0,
            // The edge of the map's voxels. The map's bounds below are whole
            // voxels.
            voxel_size_m: 0.02,
            // The box the map covers: everywhere the arm's collision meshes
            // reach within its joint limits, grown by min_clearance_m plus the
            // 1 mm a planned state keeps, and rounded out to whole voxels. The
            // reach is x -0.3473 to 0.4863 m, y -0.4467 to 0.4481 m and z
            // -0.2338 to 0.5362 m, over 30000 random configurations for each of
            // three seeds, which agree within 5.9 mm.
            map_min_x_m: -0.36,
            map_min_y_m: -0.46,
            map_min_z_m: -0.24,
            map_max_x_m: 0.50,
            map_max_y_m: 0.46,
            map_max_z_m: 0.54,
            // The most goal configurations the goal sampler adds to a plan:
            // MoveIt's max_goal_samples default (moveit2 2.15.2
            // planning_context_manager.cpp:258).
            goal_samples: 10,
            // The iteration limit of a plan. Under it, SO-101's success rate in
            // public-peppy-libs' arm planning parity scenario is at least
            // MoveIt's, which limits a plan by time alone.
            max_iterations: 20000,
            // MoveIt's default num_planning_attempts.
            planning_attempts: 1,
          },
          links: {
            // Who the robot is: the initializer names its model, so101.
            identity: "init_inst",
            // The arm's measured joints and the gripper's opening.
            limb_state: "backbone_inst",
            // SO-101 carries no depth camera, and its design names no
            // perception camera.
            camera_mounts: { vacant: "SO-101 carries no perception camera" },
            workspace: { vacant: "SO-101 carries no perception camera" },
            camera: { vacant: "SO-101 has no depth camera: a plan keeps clear of the planning scene's objects" },
            geometry: { vacant: "SO-101 has no depth camera: a plan keeps clear of the planning scene's objects" },
          },
        },
      ],
    },
  ],
}
